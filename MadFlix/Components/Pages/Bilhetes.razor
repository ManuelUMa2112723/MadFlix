@page "/bilhetes"
@rendermode InteractiveServer
@using MadFlix.Models
@using MadFlix.Models.Acessos
@inject IBilheteHistoricoService BilheteHistoricoService
@inject IFestivalMovieService FestivalMovieService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Bilhetes</PageTitle>

<AuthorizeView Roles="User,Admin">
    <Authorized>
        <section class="tickets-page">
            <div class="tickets-heading">
                <h1>Bilhetes</h1>
                <p>Historico dos acessos comprados nesta conta.</p>
            </div>

            @if (carregando)
            {
                <p>A carregar bilhetes...</p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(mensagem))
                {
                    <div class="alert alert-success">@mensagem</div>
                }

                @if (!string.IsNullOrWhiteSpace(erro))
                {
                    <div class="alert alert-danger">@erro</div>
                }

                <div class="ticket-tabs" role="tablist" aria-label="Estado dos bilhetes">
                    <button class="@ObterClasseTab(EstadoBilhetes.Ativos)"
                            type="button"
                            @onclick="() => estadoSelecionado = EstadoBilhetes.Ativos">
                        Ativos (@historico.Ativos.Count)
                    </button>
                    <button class="@ObterClasseTab(EstadoBilhetes.Pendentes)"
                            type="button"
                            @onclick="() => estadoSelecionado = EstadoBilhetes.Pendentes">
                        Pendentes (@historico.Pendentes.Count)
                    </button>
                    <button class="@ObterClasseTab(EstadoBilhetes.Expirados)"
                            type="button"
                            @onclick="() => estadoSelecionado = EstadoBilhetes.Expirados">
                        Expirados (@historico.Expirados.Count)
                    </button>
                </div>

                @if (ObterBilhetesSelecionados().Count == 0)
                {
                    <p class="tickets-empty">@ObterMensagemVazia()</p>
                }
                else
                {
                    <div class="ticket-list">
                        @foreach (var bilhete in ObterBilhetesSelecionados())
                        {
                            <article class="ticket-card">
                                <div>
                                    <span class="ticket-kind">@ObterDescricaoTipo(bilhete.TipoAcesso)</span>
                                    <h2>@bilhete.Nome</h2>
                                    @if (bilhete.TipoAcesso == TipoAcesso.PasseDiario ||
                                         bilhete.TipoAcesso == TipoAcesso.PasseCompleto ||
                                         bilhete.TipoAcesso == TipoAcesso.AluguerDigital)
                                    {
                                        <p>@ObterTextoPeriodoPasse(bilhete)</p>
                                        <p>
                                            Acesso:
                                            @bilhete.InicioAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            -
                                            @bilhete.FimAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </p>
                                        <div class="ticket-session-list">
                                            @foreach (var sessao in ObterSessoesFestival(bilhete))
                                            {
                                                <span class="@sessao.ClasseCss">
                                                    <strong>@sessao.Nome</strong>
                                                    @sessao.Inicio.ToString("HH:mm") - @sessao.Fim.ToString("HH:mm")
                                                    <em>@sessao.Estado</em>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p>
                                            @bilhete.InicioAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            -
                                            @bilhete.FimAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </p>
                                        <span class="@ObterEstadoSessao(bilhete).ClasseCss">
                                            <strong>Sessao</strong>
                                            @ObterEstadoSessao(bilhete).Inicio.ToString("HH:mm") - @ObterEstadoSessao(bilhete).Fim.ToString("HH:mm")
                                            <em>@ObterEstadoSessao(bilhete).Estado</em>
                                        </span>
                                    }
                                    <small>Comprado em @bilhete.CompradoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>

                                <div class="ticket-actions">
                                    @if (estadoSelecionado == EstadoBilhetes.Ativos && bilhete.FilmeId.HasValue)
                                    {
                                        <button class="btn btn-success ticket-watch-button"
                                                type="button"
                                                @onclick="() => VerFilme(bilhete.FilmeId.Value)">
                                            Ver filme
                                        </button>
                                    }
                                    else if (estadoSelecionado == EstadoBilhetes.Ativos && bilhete.FestivalId.HasValue)
                                    {
                                        <button class="btn btn-success ticket-watch-button"
                                                type="button"
                                                @onclick="() => AlternarCatalogoFestival(bilhete)">
                                            @ObterTextoBotaoCatalogo(bilhete)
                                        </button>
                                    }

                                    <button class="btn btn-outline-danger"
                                            type="button"
                                            @onclick="() => RemoverBilhete(bilhete)">
                                        Remover
                                    </button>
                                </div>

                                @if (CatalogoEstaAberto(bilhete))
                                {
                                    <div class="ticket-catalog">
                                        @if (catalogosACarregar.Contains(bilhete.FestivalId!.Value))
                                        {
                                            <p>A carregar catalogo...</p>
                                        }
                                        else if (filmesPorFestival.TryGetValue(bilhete.FestivalId.Value, out var filmesFestival) && filmesFestival.Count > 0)
                                        {
                                            <div class="ticket-catalog-grid">
                                                @foreach (var filme in filmesFestival)
                                                {
                                                    <article class="ticket-movie">
                                                        <div>
                                                            <strong>@filme.Titulo</strong>
                                                            <span>@filme.Genero</span>
                                                            <small class="@ObterEstadoSessao(bilhete).ClasseCss">
                                                                @ObterEstadoSessao(bilhete).Estado
                                                            </small>
                                                        </div>
                                                        <button class="btn btn-sm btn-success"
                                                                type="button"
                                                                @onclick="() => VerFilme(filme.Id)">
                                                            Ver filme
                                                        </button>
                                                    </article>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p>Este festival ainda nao tem filmes no catalogo.</p>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            }
        </section>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            Inicie sessao para ver o historico de bilhetes.
        </div>
        <a class="btn btn-primary" href="@GetLoginUrl()">Iniciar sessao</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private BilheteHistorico historico = new();
    private EstadoBilhetes estadoSelecionado = EstadoBilhetes.Ativos;
    private bool carregando = true;
    private int? utilizadorId;
    private string? mensagem;
    private string? erro;
    private readonly Dictionary<int, List<Filme>> filmesPorFestival = new();
    private readonly HashSet<int> catalogosAbertos = new();
    private readonly HashSet<int> catalogosACarregar = new();

    protected override async Task OnInitializedAsync()
    {
        utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            carregando = false;
            return;
        }

        await CarregarHistorico();
        carregando = false;
    }

    private async Task CarregarHistorico()
    {
        if (utilizadorId is null)
            return;

        historico = await BilheteHistoricoService.ObterHistoricoAsync(utilizadorId.Value);
    }

    private IReadOnlyList<HistoricoAcessoItem> ObterBilhetesSelecionados()
    {
        return estadoSelecionado switch
        {
            EstadoBilhetes.Pendentes => historico.Pendentes,
            EstadoBilhetes.Expirados => historico.Expirados,
            _ => historico.Ativos
        };
    }

    private string ObterClasseTab(EstadoBilhetes estado)
    {
        return estadoSelecionado == estado
            ? "ticket-tab active"
            : "ticket-tab";
    }

    private string ObterMensagemVazia()
    {
        return estadoSelecionado switch
        {
            EstadoBilhetes.Pendentes => "Nao tem bilhetes pendentes.",
            EstadoBilhetes.Expirados => "Nao tem bilhetes expirados.",
            _ => "Nao tem bilhetes ativos neste momento."
        };
    }

    private static SessaoEstadoViewModel ObterEstadoSessao(HistoricoAcessoItem bilhete)
    {
        var inicio = bilhete.InicioAcessoUtc.ToLocalTime();
        var fim = bilhete.FimAcessoUtc.ToLocalTime();
        var estado = new SessaoEstadoContext(inicio, fim, DateTime.Now);

        return new SessaoEstadoViewModel
        {
            Nome = "Sessao",
            Inicio = inicio,
            Fim = fim,
            Estado = estado.Nome,
            ClasseCss = estado.ClasseCss,
            Disponivel = estado.Disponivel
        };
    }

    private static IReadOnlyList<SessaoEstadoViewModel> ObterSessoesFestival(HistoricoAcessoItem bilhete)
    {
        if (bilhete.TipoAcesso == TipoAcesso.AluguerDigital)
        {
            var inicio = bilhete.InicioAcessoUtc.ToLocalTime();
            var fim = bilhete.FimAcessoUtc.ToLocalTime();
            var estado = new SessaoEstadoContext(inicio, fim, DateTime.Now);

            return
            [
                new SessaoEstadoViewModel
                {
                    Nome = "Sessao coberta",
                    Inicio = inicio,
                    Fim = fim,
                    Estado = estado.Nome,
                    ClasseCss = estado.ClasseCss,
                    Disponivel = estado.Disponivel
                }
            ];
        }

        var dia = bilhete.InicioAcessoUtc.ToLocalTime().Date;

        return SessaoFestivalCatalog.SessoesPasseDiario
            .Select(sessao =>
            {
                var inicio = sessao.ObterInicio(dia);
                var fim = sessao.ObterFim(dia);
                var estado = new SessaoEstadoContext(inicio, fim, DateTime.Now);

                return new SessaoEstadoViewModel
                {
                    Nome = sessao.Nome,
                    Inicio = inicio,
                    Fim = fim,
                    Estado = estado.Nome,
                    ClasseCss = estado.ClasseCss,
                    Disponivel = estado.Disponivel
                };
            })
            .ToList();
    }

    private static string ObterTextoPeriodoPasse(HistoricoAcessoItem bilhete)
    {
        return bilhete.TipoAcesso switch
        {
            TipoAcesso.PasseCompleto => $"Dia da sessao {bilhete.InicioAcessoUtc.ToLocalTime():dd/MM/yyyy}",
            TipoAcesso.AluguerDigital => "Janela coberta pelo aluguer digital",
            _ => $"Dia {bilhete.InicioAcessoUtc.ToLocalTime():dd/MM/yyyy}"
        };
    }

    private void VerFilme(int filmeId)
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.ToLocalPath());
        NavigationManager.NavigateTo($"/filmes/{filmeId}/assistir?returnUrl={returnUrl}");
    }

    private async Task AlternarCatalogoFestival(HistoricoAcessoItem bilhete)
    {
        if (!bilhete.FestivalId.HasValue)
            return;

        if (!catalogosAbertos.Add(bilhete.Id))
        {
            catalogosAbertos.Remove(bilhete.Id);
            return;
        }

        var festivalId = bilhete.FestivalId.Value;

        if (filmesPorFestival.ContainsKey(festivalId))
            return;

        catalogosACarregar.Add(festivalId);
        filmesPorFestival[festivalId] = (await FestivalMovieService.ListarFilmesAsync(festivalId)).ToList();
        catalogosACarregar.Remove(festivalId);
    }

    private bool CatalogoEstaAberto(HistoricoAcessoItem bilhete)
    {
        return bilhete.FestivalId.HasValue && catalogosAbertos.Contains(bilhete.Id);
    }

    private string ObterTextoBotaoCatalogo(HistoricoAcessoItem bilhete)
    {
        return CatalogoEstaAberto(bilhete)
            ? "Esconder catalogo"
            : "Ver catalogo";
    }

    private async Task RemoverBilhete(HistoricoAcessoItem bilhete)
    {
        mensagem = null;
        erro = null;

        if (utilizadorId is null)
        {
            erro = "Tem de iniciar sessao para remover bilhetes.";
            return;
        }

        var resultado = await BilheteHistoricoService.RemoverBilheteAsync(
            utilizadorId.Value,
            bilhete.Id,
            bilhete.AcessoFestival);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        mensagem = resultado.Value;
        await CarregarHistorico();
    }

    private async Task<int?> ObterUtilizadorIdAutenticado()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.GetMadFlixUserId();
    }

    private string GetLoginUrl()
    {
        return $"/login?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }

    private static string ObterDescricaoTipo(TipoAcesso tipo)
    {
        return tipo switch
        {
            TipoAcesso.BilheteSessao => "Bilhete de sessao",
            TipoAcesso.PasseDiario => "Passe diario",
            TipoAcesso.PasseCompleto => "Passe completo",
            TipoAcesso.AluguerDigital => "Aluguer digital",
            _ => "Acesso"
        };
    }

    private enum EstadoBilhetes
    {
        Ativos,
        Pendentes,
        Expirados
    }
}
