@page "/"
@rendermode InteractiveServer
@inject ICarrinhoService CarrinhoService
@inject IFilmeCatalogService FilmeCatalogService
@inject IFestivalCatalogService FestivalCatalogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>MadFlix</PageTitle>

<HomeHero FeaturedFestival="@festivalDestaque" />

@if (!string.IsNullOrWhiteSpace(mensagemCarrinho))
{
    <div class="alert alert-success home-alert">@mensagemCarrinho</div>
}

@if (!string.IsNullOrWhiteSpace(erroCarrinho))
{
    <div class="alert alert-danger home-alert">@erroCarrinho</div>
}

<MovieRail Kicker="Recomendados"
           Title="Escolhas da casa para hoje"
           TitleId="recommended-title"
           ActionHref="festivais"
           ActionText="Explorar festivais"
           IsLoading="@carregandoRecomendados"
           IsAuthenticated="@utilizadorAutenticado"
           Movies="@filmesRecomendados"
           MovieSelected="@AbrirDetalhesFilme"
           TicketRequested="@AdicionarBilheteSessaoAoCarrinhoAsync" />

<FestivalRail Festivals="@festivaisDestaque" />

@code {
    private readonly string[] titulosRecomendados =
    [
        "The Matrix",
        "Interstellar",
        "The Godfather",
        "The Dark Knight",
        "Pulp Fiction",
        "Fight Club"
    ];

    private const decimal PrecoBilheteSessao = 6.99m;
    private readonly List<Filme> filmesRecomendados = new();
    private IReadOnlyList<Festival> festivaisDestaque = [];
    private Festival? festivalDestaque;
    private bool carregandoRecomendados = true;
    private string? mensagemCarrinho;
    private string? erroCarrinho;
    private bool utilizadorAutenticado;
    private int? utilizadorId;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUtilizadorAtualAsync();
        await CarregarFestivalDestaqueAsync();
        await CarregarRecomendadosAsync();
    }

    private async Task CarregarFestivalDestaqueAsync()
    {
        var hoje = DateTime.Today;
        var festivais = await FestivalCatalogService.ListarAsync();

        festivaisDestaque = festivais
            .OrderBy(f => f.DataFim.Date < hoje)
            .ThenBy(f => f.DataInicio.Date < hoje ? hoje : f.DataInicio.Date)
            .ToList();

        festivalDestaque = festivaisDestaque
            .FirstOrDefault();
    }

    private async Task CarregarRecomendadosAsync()
    {
        foreach (var titulo in titulosRecomendados)
        {
            var resultado = await FilmeCatalogService.BuscarFilmeAsync(titulo);

            if (resultado.Succeeded && resultado.Value is not null)
                filmesRecomendados.Add(resultado.Value);
        }

        carregandoRecomendados = false;
    }

    private async Task CarregarUtilizadorAtualAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        utilizadorId = authenticationState.User.GetMadFlixUserId();
        utilizadorAutenticado = utilizadorId.HasValue;
    }

    private void AbrirDetalhesFilme(int filmeId)
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.ToLocalPath());
        NavigationManager.NavigateTo($"/filmes/{filmeId}?returnUrl={returnUrl}");
    }

    private async Task AdicionarBilheteSessaoAoCarrinhoAsync(Filme filmeSelecionado)
    {
        await CarregarUtilizadorAtualAsync();

        if (!utilizadorId.HasValue)
        {
            erroCarrinho = "Tem de iniciar sessao para adicionar bilhetes ao carrinho.";
            mensagemCarrinho = null;
            return;
        }

        var resultado = await CarrinhoService.AdicionarBilheteSessaoAsync(
            utilizadorId.Value,
            filmeSelecionado.Id,
            PrecoBilheteSessao);

        if (!resultado.Succeeded)
        {
            erroCarrinho = resultado.ErrorMessage;
            mensagemCarrinho = null;
            return;
        }

        erroCarrinho = null;
        mensagemCarrinho = $"{resultado.Value} Sessao das 11:30 as 16:30.";
    }
}
