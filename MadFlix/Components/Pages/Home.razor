@page "/"
@rendermode InteractiveServer
@inject IFilmeCatalogService FilmeCatalogService
@inject IFilmePurchaseService FilmePurchaseService
@inject IFilmePlaybackService FilmePlaybackService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>MadFlix</PageTitle>

<div class="home-header">
    <div>
        <h1>MadFlix</h1>
        <p class="text-muted mb-0">Qualquer visitante pode pesquisar o catalogo. Para comprar ou assistir, tem de iniciar sessao.</p>
    </div>

    <div class="search-bar">
        <div class="search-type">
            <label>
                <input type="radio"
                       name="tipoBusca"
                       value="filme"
                       @onchange="OnTipoBuscaChange"
                       checked="@(tipoBusca == "filme")" />
                Filme
            </label>
            <label>
                <input type="radio"
                       name="tipoBusca"
                       value="ator"
                       @onchange="OnTipoBuscaChange"
                       checked="@(tipoBusca == "ator")" />
                Ator
            </label>
        </div>

        <input type="text"
               @oninput="e => termoBusca = e.Value?.ToString() ?? string.Empty"
               @onkeydown="PesquisarComEnter"
               placeholder="@(tipoBusca == "filme" ? "Pesquisar filme..." : "Pesquisar ator...")" />

        <button class="btn btn-primary" @onclick="Buscar">
            Pesquisar
        </button>
    </div>
</div>

@if (carregando)
{
    <p class="mt-3">A pesquisar...</p>
}

@if (erro != null)
{
    <div class="alert alert-danger mt-3">@erro</div>
}

@if (filme != null)
{
    <section class="movie-result">
        @if (!string.IsNullOrEmpty(filme.Poster))
        {
            <img src="@filme.Poster" alt="@filme.Titulo" />
        }

        <div>
            <h2>@filme.Titulo (@filme.Ano)</h2>
            <p><strong>Genero:</strong> @filme.Genero</p>
            <p><strong>Sinopse:</strong> @filme.Sinopse</p>
            <p><strong>Avaliacao IMDb:</strong> @filme.ImdbRating</p>
            <p><strong>Duracao:</strong> @filme.Runtime</p>
            <p><strong>Classificacao:</strong> @filme.Rated</p>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-success" @onclick="ComprarFilmeAsync" disabled="@(!utilizadorAutenticado)">
                    Comprar
                </button>
                <button class="btn btn-outline-primary" @onclick="AssistirFilmeAsync" disabled="@(!utilizadorAutenticado)">
                    Assistir
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensagemAcao))
            {
                <div class="alert alert-success mt-3 mb-0">@mensagemAcao</div>
            }

            @if (!string.IsNullOrWhiteSpace(erroAcao))
            {
                <div class="alert alert-danger mt-3 mb-0">@erroAcao</div>
            }

            @if (!utilizadorAutenticado)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    Esta a navegar como visitante. Inicie sessao para comprar ou assistir.
                </div>

                <div class="d-flex gap-2 mt-3">
                    <a class="btn btn-sm btn-primary" href="@GetLoginUrl()">Iniciar sessao</a>
                    <a class="btn btn-sm btn-outline-secondary" href="@GetRegisterUrl()">Criar conta</a>
                </div>
            }
        </div>
    </section>
}

<section class="recommended-section">
    <h2>Recomendados</h2>

    @if (carregandoRecomendados)
    {
        <p>A carregar filmes recomendados...</p>
    }
    else if (filmesRecomendados.Count > 0)
    {
        <div class="movie-grid">
            @foreach (var recomendado in filmesRecomendados)
            {
                <article class="movie-card">
                    @if (!string.IsNullOrWhiteSpace(recomendado.Poster) && recomendado.Poster != "N/A")
                    {
                        <img src="@recomendado.Poster" alt="@recomendado.Titulo" />
                    }
                    else
                    {
                        <div class="movie-card-placeholder">@recomendado.Titulo</div>
                    }

                    <div class="movie-card-body">
                        <h3>@recomendado.Titulo</h3>
                        <p>@recomendado.Genero</p>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p>Nao foi possivel carregar recomendacoes neste momento.</p>
    }
</section>

<style>
    .home-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .home-header h1 {
        margin: 0;
    }

    .search-bar {
        display: flex;
        gap: .75rem;
        width: min(700px, 100%);
    }

    .search-type {
        display: flex;
        align-items: center;
        gap: .75rem;
        white-space: nowrap;
    }

    .search-type label {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        margin: 0;
    }

    .search-bar input[type="text"] {
        flex: 1;
        padding: .65rem .8rem;
        border: 1px solid #ced4da;
        border-radius: .375rem;
        font-size: 1rem;
    }

    .movie-result {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 1.5rem;
        align-items: start;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        padding: 1rem;
        margin-bottom: 2rem;
    }

    .movie-result img {
        width: 180px;
        border-radius: .375rem;
    }

    .recommended-section h2 {
        margin-bottom: 1rem;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: 1rem;
    }

    .movie-card {
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        overflow: hidden;
        background: #fff;
    }

    .movie-card img,
    .movie-card-placeholder {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        background: #111827;
        color: #fff;
    }

    .movie-card-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        text-align: center;
        font-weight: 600;
    }

    .movie-card-body {
        padding: .75rem;
    }

    .movie-card-body h3 {
        font-size: 1rem;
        margin: 0 0 .35rem;
    }

    .movie-card-body p {
        color: #6c757d;
        font-size: .9rem;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .home-header {
            align-items: stretch;
            flex-direction: column;
        }

        .search-bar {
            flex-direction: column;
        }

        .search-type {
            align-items: flex-start;
        }

        .movie-result {
            grid-template-columns: 1fr;
        }

        .movie-result img {
            width: 160px;
        }
    }
</style>

@code {
    private readonly string[] titulosRecomendados =
    [
        "Inception",
        "Interstellar",
        "The Godfather",
        "The Dark Knight",
        "Pulp Fiction",
        "Fight Club"
    ];

    private readonly List<Filme> filmesRecomendados = new();
    private string termoBusca = string.Empty;
    private string tipoBusca = "filme";
    private Filme? filme;
    private bool carregando;
    private bool carregandoRecomendados = true;
    private string? erro;
    private string? mensagemAcao;
    private string? erroAcao;
    private bool utilizadorAutenticado;
    private int? utilizadorId;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUtilizadorAtualAsync();
        await CarregarRecomendadosAsync();
    }

    private async Task CarregarRecomendadosAsync()
    {
        foreach (var titulo in titulosRecomendados)
        {
            var resultado = await FilmeCatalogService.BuscarFilmeAsync(titulo);

            if (resultado.Succeeded && resultado.Value is not null)
                filmesRecomendados.Add(resultado.Value);
        }

        carregandoRecomendados = false;
    }

    private async Task PesquisarComEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Buscar();
    }

    private void OnTipoBuscaChange(ChangeEventArgs e)
    {
        tipoBusca = e.Value?.ToString() ?? "filme";
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(termoBusca))
            return;

        if (tipoBusca == "ator")
        {
            NavigationManager.NavigateTo($"/ator?nome={Uri.EscapeDataString(termoBusca)}");
            return;
        }

        carregando = true;
        erro = null;
        erroAcao = null;
        mensagemAcao = null;
        filme = null;

        var resultado = await FilmeCatalogService.BuscarFilmeAsync(termoBusca);

        if (!resultado.Succeeded || resultado.Value is null)
        {
            erro = resultado.ErrorMessage;
            carregando = false;
            return;
        }

        filme = resultado.Value;
        carregando = false;
    }

    private async Task AssistirFilmeAsync()
    {
        await CarregarUtilizadorAtualAsync();

        if (!utilizadorId.HasValue || filme is null)
        {
            erroAcao = "Tem de iniciar sessao para assistir.";
            mensagemAcao = null;
            return;
        }

        var resultado = await FilmePlaybackService.AssistirAsync(utilizadorId.Value, filme.Id);

        if (!resultado.Succeeded)
        {
            mensagemAcao = null;
            erroAcao = resultado.ErrorMessage;
            return;
        }

        erroAcao = null;
        mensagemAcao = resultado.Value;
    }

    private async Task CarregarUtilizadorAtualAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        utilizadorId = authenticationState.User.GetMadFlixUserId();
        utilizadorAutenticado = utilizadorId.HasValue;
    }

    private async Task ComprarFilmeAsync()
    {
        await CarregarUtilizadorAtualAsync();

        if (!utilizadorId.HasValue || filme is null)
        {
            erroAcao = "Tem de iniciar sessao para comprar.";
            mensagemAcao = null;
            return;
        }

        var resultado = await FilmePurchaseService.ComprarAsync(utilizadorId.Value, filme.Id);

        if (!resultado.Succeeded)
        {
            mensagemAcao = null;
            erroAcao = resultado.ErrorMessage;
            return;
        }

        erroAcao = null;
        mensagemAcao = resultado.Value;
    }

    private string GetLoginUrl()
    {
        return $"/login?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }

    private string GetRegisterUrl()
    {
        return $"/registar?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }
}
