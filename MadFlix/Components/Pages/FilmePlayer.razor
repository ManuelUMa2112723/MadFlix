@using MadFlix.Models
@using MadFlix.Services
@page "/filmes/{FilmeId:int}/assistir"
@rendermode InteractiveServer
@inject IFilmeCatalogService FilmeCatalogService
@inject IFilmePlaybackService FilmePlaybackService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(filme is null ? "Ver filme" : $"Ver filme - {filme.Titulo}")</PageTitle>

@if (carregando)
{
    <p>A carregar filme...</p>
}
else if (!string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-danger">@erro</div>
    <button class="btn btn-outline-light" type="button" @onclick="Voltar">
        Voltar
    </button>
}
else if (filme is not null)
{
    <section class="watch-page">
        <button class="btn btn-link px-0 watch-back" type="button" @onclick="Voltar">
            Voltar
        </button>

        <div class="watch-heading">
            <h1>@filme.Titulo</h1>
            <p>Simulacao do filme</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(playerEmbedUrl))
        {
            <iframe class="watch-player"
                    src="@playerEmbedUrl"
                    title="Filme @filme.Titulo"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen></iframe>
        }
        else if (!string.IsNullOrWhiteSpace(filme.TrailerUrl))
        {
            <a class="btn btn-light" href="@filme.TrailerUrl" target="_blank" rel="noopener noreferrer">
                Abrir filme
            </a>
        }
        else
        {
            <div class="alert alert-warning">
                Este filme ainda nao tem video associado.
            </div>
        }
    </section>
}

<style>
    .watch-page {
        margin: 1rem auto;
        max-width: 1180px;
    }

    .watch-back {
        color: #ffffff;
        font-weight: 700;
    }

    .watch-heading {
        margin-bottom: 1rem;
    }

    .watch-heading h1 {
        font-size: 2.4rem;
        margin: 0;
    }

    .watch-heading p {
        color: #e9eef7;
        font-weight: 700;
        margin: .35rem 0 0;
    }

    .watch-player {
        aspect-ratio: 16 / 9;
        border: 0;
        border-radius: .5rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .25);
        width: 100%;
    }
</style>

@code {
    [Parameter]
    public int FilmeId { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private Filme? filme;
    private string? playerEmbedUrl;
    private bool carregando = true;
    private string? erro;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        erro = null;

        var utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            erro = "Tem de iniciar sessao e ter um bilhete de sessao valido para ver o filme.";
            carregando = false;
            return;
        }

        var acesso = await FilmePlaybackService.AssistirAsync(utilizadorId.Value, FilmeId);

        if (!acesso.Succeeded)
        {
            erro = acesso.ErrorMessage;
            carregando = false;
            return;
        }

        var resultado = await FilmeCatalogService.ObterDetalhesAsync(FilmeId);

        if (!resultado.Succeeded || resultado.Value is null)
        {
            erro = resultado.ErrorMessage;
            carregando = false;
            return;
        }

        filme = resultado.Value;
        playerEmbedUrl = ObterYoutubeEmbedUrl(filme.TrailerUrl);
        carregando = false;
    }

    private async Task<int?> ObterUtilizadorIdAutenticado()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.GetMadFlixUserId();
    }

    private void Voltar()
    {
        NavigationManager.NavigateTo(NavigationHelpers.NormalizeReturnUrl(ReturnUrl));
    }

    private static string? ObterYoutubeEmbedUrl(string? trailerUrl)
    {
        if (string.IsNullOrWhiteSpace(trailerUrl) ||
            !Uri.TryCreate(trailerUrl, UriKind.Absolute, out var uri))
        {
            return null;
        }

        var host = uri.Host.ToLowerInvariant();

        if (host.Contains("youtu.be"))
        {
            var videoId = uri.AbsolutePath.Trim('/');
            return string.IsNullOrWhiteSpace(videoId)
                ? null
                : $"https://www.youtube.com/embed/{videoId}";
        }

        if (host.Contains("youtube.com"))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var videoId = query["v"];
            return string.IsNullOrWhiteSpace(videoId)
                ? null
                : $"https://www.youtube.com/embed/{videoId}";
        }

        return null;
    }
}
