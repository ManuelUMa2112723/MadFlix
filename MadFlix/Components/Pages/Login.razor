@page "/login"

<PageTitle>Iniciar sessao</PageTitle>

<h1>Iniciar sessao</h1>
<p class="text-muted">Pode navegar livremente no catalogo. Para comprar ou assistir, entre com a sua conta.</p>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger mt-3">@Error</div>
}

<form class="border rounded p-4 mt-4" method="post" action="/auth/login">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ResolvedReturnUrl" />

    <div class="mb-3">
        <label class="form-label" for="identificador">Email ou nome de utilizador</label>
        <input id="identificador" class="form-control" type="text" name="identificador" required />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input id="password" class="form-control" type="password" name="password" required />
    </div>

    <button class="btn btn-primary" type="submit">Entrar</button>
</form>

<p class="mt-3 mb-0">
    Ainda nao tem conta?
    <a href="@GetRegisterUrl()">Criar conta</a>
</p>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string ResolvedReturnUrl => NavigationHelpers.NormalizeReturnUrl(ReturnUrl);

    private string GetRegisterUrl()
    {
        return $"/registar?returnUrl={Uri.EscapeDataString(ResolvedReturnUrl)}";
    }
}
