@page "/festivais"
@rendermode InteractiveServer
@using MadFlix.Factories
@using MadFlix.Models
@using MadFlix.Models.Acessos
@using MadFlix.Services
@inject FestivalService FestivalService
@inject IAcessoFactory AcessoFactory

<PageTitle>Festivais</PageTitle>

<h1>Festivais</h1>

<section class="border rounded p-3 mb-4">
    <h2 class="h4">Area do utilizador</h2>
    <p class="text-muted mb-3">Visualizacao simples dos festivais disponiveis.</p>

    <button class="btn btn-outline-primary" @onclick="MostrarFestivaisDisponiveis">
        Ver festivais disponiveis
    </button>

    @if (!string.IsNullOrWhiteSpace(mensagemCarrinho))
    {
        <div class="alert alert-success mt-3">@mensagemCarrinho</div>
    }

    @if (mostrarListaUtilizador)
    {
        <div class="mt-4">
            @if (carregando)
            {
                <p>A carregar festivais...</p>
            }
            else if (festivais.Count > 0)
            {
                <div class="list-group">
                    @foreach (var festival in festivais)
                    {
                        var compra = ObterCompraFestival(festival);

                        <div class="list-group-item">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-7">
                                    <h3 class="h5 mb-1">@festival.Nome</h3>
                                    <p class="mb-1"><strong>Genero:</strong> @festival.Genero</p>
                                    <p class="mb-1">
                                        <strong>Datas:</strong>
                                        @festival.DataInicio.ToShortDateString() - @festival.DataFim.ToShortDateString()
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(festival.Descricao))
                                    {
                                        <p class="mb-0">@festival.Descricao</p>
                                    }
                                </div>

                                <div class="col-lg-5">
                                    <div class="row g-2">
                                        <div class="col-md-5">
                                            <label class="form-label" for="@($"tipo-acesso-{festival.Id}")">Tipo de acesso</label>
                                            <select id="@($"tipo-acesso-{festival.Id}")"
                                                    class="form-select"
                                                    value="@compra.Tipo"
                                                    @onchange="e => AlterarTipoAcesso(festival.Id, e.Value?.ToString())">
                                                <option value="@TipoAcesso.PasseDiario">Passe diario</option>
                                                <option value="@TipoAcesso.PasseCompleto">Passe completo</option>
                                                <option value="@TipoAcesso.AluguerDigital">Aluguer digital</option>
                                            </select>
                                        </div>

                                        @if (compra.Tipo == TipoAcesso.PasseDiario)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label" for="@($"dia-acesso-{festival.Id}")">Dia</label>
                                                <input id="@($"dia-acesso-{festival.Id}")"
                                                       class="form-control"
                                                       type="date"
                                                       value="@compra.DiaFestival.ToString("yyyy-MM-dd")"
                                                       @onchange="e => AlterarDiaFestival(festival.Id, e.Value?.ToString())" />
                                            </div>
                                        }
                                        else if (compra.Tipo == TipoAcesso.AluguerDigital)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label" for="@($"horas-aluguer-{festival.Id}")">Horas</label>
                                                <input id="@($"horas-aluguer-{festival.Id}")"
                                                       class="form-control"
                                                       type="number"
                                                       min="1"
                                                       value="@compra.HorasAluguer"
                                                       @onchange="e => AlterarHorasAluguer(festival.Id, e.Value?.ToString())" />
                                            </div>
                                        }

                                        <div class="col-md-3 d-grid">
                                            <button class="btn btn-success"
                                                    @onclick="() => AdicionarAoCarrinho(festival)">
                                                Adicionar ao carrinho
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Ainda nao existem festivais disponiveis.</p>
            }
        </div>
    }

    @if (carrinho.Count > 0)
    {
        <div class="mt-4">
            <h3 class="h5">Carrinho</h3>
            <ul class="list-group">
                @foreach (var item in carrinho)
                {
                    <li class="list-group-item">
                        <strong>@item.NomeFestival</strong> - @item.TipoDescricao
                        <span class="text-muted">
                            (@item.Inicio.ToString("dd/MM/yyyy HH:mm") - @item.Fim.ToString("dd/MM/yyyy HH:mm"))
                        </span>
                    </li>
                }
            </ul>
        </div>
    }
</section>

<section class="border rounded p-3">
    <h2 class="h4">Area de administracao</h2>
    <p class="text-muted mb-3">Zona temporaria para criar festivais. Mais tarde fica apenas para administradores.</p>

    <button class="btn btn-primary mb-4" @onclick="MostrarFormulario">
        Adicionar festival
    </button>

    @if (mostrarFormulario)
    {
        <EditForm Model="form" OnValidSubmit="CriarFestival" class="border rounded p-3 mb-4">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="nome">Nome</label>
                <InputText id="nome" class="form-control" @bind-Value="form.Nome" placeholder="Festival de Terror" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="genero">Genero</label>
                <InputText id="genero" class="form-control" @bind-Value="form.Genero" placeholder="Terror" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="descricao">Descricao</label>
                <InputTextArea id="descricao" class="form-control" @bind-Value="form.Descricao" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="dataInicio">Data de inicio</label>
                    <InputDate id="dataInicio" class="form-control" @bind-Value="form.DataInicio" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="dataFim">Data de fim</label>
                    <InputDate id="dataFim" class="form-control" @bind-Value="form.DataFim" />
                </div>
            </div>

            <button class="btn btn-success" type="submit">Guardar</button>
            <button class="btn btn-link" type="button" @onclick="EsconderFormulario">Cancelar</button>

            <ValidationSummary class="text-danger mt-3" />
        </EditForm>
    }

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert alert-success">@mensagem</div>
    }

    @if (!string.IsNullOrWhiteSpace(erro))
    {
        <div class="alert alert-danger">@erro</div>
    }
</section>

@code {
    private const decimal PrecoPasseDiario = 9.99m;
    private const decimal PrecoPasseCompleto = 29.99m;
    private const decimal PrecoAluguerDigital = 14.99m;
    private const int HorasPadraoAluguerDigital = 48;

    private readonly FestivalForm form = new();
    private readonly Dictionary<int, CompraFestivalForm> comprasPorFestival = new();
    private readonly List<CarrinhoItem> carrinho = new();
    private List<Festival> festivais = new();
    private bool mostrarFormulario;
    private bool mostrarListaUtilizador;
    private bool carregando;
    private string? mensagem;
    private string? mensagemCarrinho;
    private string? erro;

    private void MostrarFormulario()
    {
        mostrarFormulario = true;
        mensagem = null;
        erro = null;
    }

    private void EsconderFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task MostrarFestivaisDisponiveis()
    {
        mostrarListaUtilizador = true;
        await CarregarFestivais();
    }

    private async Task CarregarFestivais()
    {
        carregando = true;
        erro = null;

        festivais = await FestivalService.ListarAsync();

        foreach (var festival in festivais)
            ObterCompraFestival(festival);

        carregando = false;
    }

    private CompraFestivalForm ObterCompraFestival(Festival festival)
    {
        if (!comprasPorFestival.TryGetValue(festival.Id, out var compra))
        {
            compra = new CompraFestivalForm
            {
                Tipo = TipoAcesso.PasseDiario,
                DiaFestival = DateTime.Today < festival.DataInicio.Date ? festival.DataInicio.Date : DateTime.Today
            };

            if (compra.DiaFestival > festival.DataFim.Date)
                compra.DiaFestival = festival.DataFim.Date;

            comprasPorFestival[festival.Id] = compra;
        }

        return compra;
    }

    private void AlterarTipoAcesso(int festivalId, string? valor)
    {
        if (!Enum.TryParse<TipoAcesso>(valor, out var tipo))
            return;

        comprasPorFestival[festivalId].Tipo = tipo;
    }

    private void AlterarDiaFestival(int festivalId, string? valor)
    {
        if (DateTime.TryParse(valor, out var dia))
            comprasPorFestival[festivalId].DiaFestival = dia;
    }

    private void AlterarHorasAluguer(int festivalId, string? valor)
    {
        if (int.TryParse(valor, out var horas) && horas > 0)
            comprasPorFestival[festivalId].HorasAluguer = horas;
    }

    private void AdicionarAoCarrinho(Festival festival)
    {
        try
        {
            var compra = ObterCompraFestival(festival);
            var compradoEm = DateTime.Now;
            Acesso acesso = compra.Tipo switch
            {
                TipoAcesso.PasseDiario => AcessoFactory.CriarPasseDiario(
                    festival.Id,
                    compra.DiaFestival,
                    festival.DataInicio,
                    festival.DataFim,
                    PrecoPasseDiario,
                    compradoEm),
                TipoAcesso.PasseCompleto => AcessoFactory.CriarPasseCompleto(
                    festival.Id,
                    festival.DataInicio,
                    festival.DataFim,
                    PrecoPasseCompleto,
                    compradoEm),
                TipoAcesso.AluguerDigital => AcessoFactory.CriarAluguerDigitalPersonalizado(
                    festival.Id,
                    compra.HorasAluguer,
                    PrecoAluguerDigital,
                    compradoEm),
                _ => throw new InvalidOperationException("Tipo de acesso invalido para festival.")
            };

            var janela = acesso.ObterJanelaAcesso();
            carrinho.Add(new CarrinhoItem(
                festival.Nome,
                ObterDescricaoTipo(acesso.Tipo),
                janela.Inicio,
                janela.Fim));

            mensagemCarrinho = $"{ObterDescricaoTipo(acesso.Tipo)} adicionado ao carrinho para {festival.Nome}.";
        }
        catch (ArgumentException ex)
        {
            mensagemCarrinho = null;
            erro = ex.Message;
        }
    }

    private async Task CriarFestival()
    {
        try
        {
            await FestivalService.CriarAsync(
                form.Nome,
                form.Genero,
                form.DataInicio,
                form.DataFim,
                form.Descricao);

            form.Limpar();
            mostrarFormulario = false;
            mensagem = "Festival criado com sucesso.";

            if (mostrarListaUtilizador)
                await CarregarFestivais();
        }
        catch (ArgumentException ex)
        {
            erro = ex.Message;
        }
    }

    private static string ObterDescricaoTipo(TipoAcesso tipo)
    {
        return tipo switch
        {
            TipoAcesso.PasseDiario => "Passe diario",
            TipoAcesso.PasseCompleto => "Passe completo",
            TipoAcesso.AluguerDigital => "Aluguer digital",
            TipoAcesso.BilheteSessao => "Bilhete de sessao",
            _ => "Acesso"
        };
    }

    private sealed class CompraFestivalForm
    {
        public TipoAcesso Tipo { get; set; }
        public DateTime DiaFestival { get; set; }
        public int HorasAluguer { get; set; } = HorasPadraoAluguerDigital;
    }

    private sealed record CarrinhoItem(
        string NomeFestival,
        string TipoDescricao,
        DateTime Inicio,
        DateTime Fim);

    private sealed class FestivalForm
    {
        public string Nome { get; set; } = string.Empty;
        public string Genero { get; set; } = string.Empty;
        public string? Descricao { get; set; }
        public DateTime DataInicio { get; set; } = DateTime.Today;
        public DateTime DataFim { get; set; } = DateTime.Today.AddDays(7);

        public void Limpar()
        {
            Nome = string.Empty;
            Genero = string.Empty;
            Descricao = null;
            DataInicio = DateTime.Today;
            DataFim = DateTime.Today.AddDays(7);
        }
    }
}
