@page "/festivais"
@rendermode InteractiveServer
@using MadFlix.Models.Acessos
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICarrinhoService CarrinhoService
@inject IFestivalCatalogService FestivalCatalogService
@inject IFestivalCreationService FestivalCreationService
@inject IFestivalFavoriteVoteService FestivalFavoriteVoteService
@inject IFestivalMovieService FestivalMovieService
@inject NavigationManager NavigationManager

<PageTitle>Festivais</PageTitle>

<section class="festival-panel" id="festivais-disponiveis">
    <div class="festival-panel-heading">
        <div>
            <p class="festival-kicker">Acessos digitais</p>
            <h2>Festivais disponiveis</h2>
        </div>
        <span>@festivais.Count programa(s)</span>
    </div>

    <section class="festival-help" aria-labelledby="festival-help-title">
        <div>
            <p class="festival-kicker">Ajuda rapida</p>
            <h3 id="festival-help-title">Como usar os festivais</h3>
        </div>
        <div class="festival-help-grid">
            <article>
                <span>1</span>
                <strong>Escolha o acesso</strong>
                <p>Use passe diario para um dia, passe completo para todo o evento ou aluguer digital por horas.</p>
            </article>
            <article>
                <span>2</span>
                <strong>Consulte o catalogo</strong>
                <p>Abra o catalogo de cada festival para ver os filmes disponiveis e entrar nos detalhes.</p>
            </article>
            <article>
                <span>3</span>
                <strong>Vote no favorito</strong>
                <p>Depois de iniciar sessao, vote no filme preferido. Pode alterar o voto enquanto o festival existir.</p>
            </article>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensagemCarrinho))
    {
        <div class="alert alert-success mt-3">@mensagemCarrinho</div>
    }

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert alert-success mt-3">@mensagem</div>
    }

    @if (!string.IsNullOrWhiteSpace(erro))
    {
        <div class="alert alert-danger mt-3">@erro</div>
    }

    <div class="festival-content">
            @if (carregando)
            {
                <p class="festival-muted">A carregar festivais...</p>
            }
            else if (festivais.Count > 0)
            {
                <div class="festival-list">
                    @for (var index = 0; index < festivais.Count; index++)
                    {
                        var festival = festivais[index];
                        var compra = ObterCompraFestival(festival);

                        <article class="festival-card" style="--festival-card-bg: url('@GetFestivalImage(index)')">
                            <div class="festival-card-grid">
                                <div class="festival-summary">
                                    <span class="festival-label">@festival.Genero</span>
                                    <h3>@festival.Nome</h3>
                                    <p class="festival-date">
                                        @festival.DataInicio.ToString("dd/MM/yyyy") - @festival.DataFim.ToString("dd/MM/yyyy")
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(festival.Descricao))
                                    {
                                        <p class="festival-description">@festival.Descricao</p>
                                    }

                                    <button class="btn festival-catalog-button" type="button"
                                            @onclick="() => AlternarCatalogoFestival(festival.Id)">
                                        @ObterTextoBotaoCatalogo(festival.Id)
                                    </button>
                                </div>

                                <div class="festival-purchase">
                                    <div class="festival-purchase-grid">
                                        <div>
                                            <label class="form-label" for="@($"tipo-acesso-{festival.Id}")">Tipo de acesso</label>
                                            <select id="@($"tipo-acesso-{festival.Id}")" class="form-select" value="@compra.Tipo"
                                                    @onchange="e => AlterarTipoAcesso(festival.Id, e.Value?.ToString())">
                                                <option value="@TipoAcesso.PasseDiario">Passe diario</option>
                                                <option value="@TipoAcesso.PasseCompleto">Passe completo</option>
                                                <option value="@TipoAcesso.AluguerDigital">Aluguer digital</option>
                                            </select>
                                        </div>

                                        @if (compra.Tipo == TipoAcesso.PasseDiario)
                                        {
                                            <div>
                                                <label class="form-label" for="@($"dia-acesso-{festival.Id}")">Dia</label>
                                                <input id="@($"dia-acesso-{festival.Id}")" class="form-control" type="date"
                                                       min="@festival.DataInicio.ToString("yyyy-MM-dd")"
                                                       max="@festival.DataFim.ToString("yyyy-MM-dd")"
                                                       value="@compra.DiaFestival.ToString("yyyy-MM-dd")"
                                                       @onchange="e => AlterarDiaFestival(festival.Id, e.Value?.ToString())" />
                                            </div>
                                        }
                                        else if (compra.Tipo == TipoAcesso.AluguerDigital)
                                        {
                                            <div>
                                                <label class="form-label" for="@($"horas-aluguer-{festival.Id}")">Horas</label>
                                                <input id="@($"horas-aluguer-{festival.Id}")" class="form-control" type="number" min="1"
                                                       value="@compra.HorasAluguer"
                                                       @onchange="e => AlterarHorasAluguer(festival.Id, e.Value?.ToString())" />
                                            </div>
                                        }

                                        <AuthorizeView>
                                            <Authorized>
                                                <div class="festival-cart-cell">
                                                    <span class="festival-price">
                                                        @ObterPreco(compra.Tipo).ToString("C")
                                                    </span>
                                                    <button class="btn festival-cart-button" @onclick="() => AdicionarAoCarrinho(festival)">
                                                        Adicionar ao carrinho
                                                    </button>
                                                </div>
                                            </Authorized>
                                            <NotAuthorized>
                                                <div class="festival-cart-cell">
                                                    <span class="festival-price">
                                                        @ObterPreco(compra.Tipo).ToString("C")
                                                    </span>
                                                    <a class="btn festival-login-button" href="@GetLoginUrl()">
                                                        Iniciar sessao
                                                    </a>
                                                </div>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </div>

                                    @if (compra.Tipo == TipoAcesso.PasseDiario ||
                                         compra.Tipo == TipoAcesso.PasseCompleto ||
                                         compra.Tipo == TipoAcesso.AluguerDigital)
                                    {
                                        <div class="festival-session-list mt-3">
                                            @foreach (var sessao in ObterSessoesFestival(compra))
                                            {
                                                <span class="@sessao.ClasseCss">
                                                    <strong>@sessao.Nome</strong>
                                                    @sessao.Inicio.ToString("HH:mm") - @sessao.Fim.ToString("HH:mm")
                                                    <em>@sessao.Estado</em>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (catalogosAbertos.Contains(festival.Id))
                            {
                                <div class="festival-catalog">
                                    @if (catalogosACarregar.Contains(festival.Id))
                                    {
                                        <p class="festival-muted mb-0">A carregar catalogo...</p>
                                    }
                                    else if (filmesPorFestival.TryGetValue(festival.Id, out var filmesFestival) && filmesFestival.Count
                    > 0)
                                    {
                                        <div class="festival-movie-grid">
                                            @foreach (var filmeFestival in filmesFestival)
                                            {
                                                <article class="festival-movie-card" role="button" tabindex="0"
                                                         @onclick="() => AbrirDetalhesFilme(filmeFestival.Id)"
                                                         @onkeydown="e => AbrirDetalhesFilmeComTecla(e, filmeFestival.Id)">
                                                    <strong>@filmeFestival.Titulo</strong>
                                                    <span>@filmeFestival.Genero</span>
                                                    <small>@filmeFestival.Ano</small>
                                                    <div class="festival-vote-row">
                                                        <span>@ObterTotalVotos(festival.Id, filmeFestival.Id) voto(s)</span>
                                                        <AuthorizeView>
                                                            <Authorized>
                                                                <button class="@ObterClasseBotaoVoto(festival.Id, filmeFestival.Id)"
                                                                        type="button"
                                                                        @onclick:stopPropagation="true"
                                                                        @onclick="() => VotarFilmeFavorito(festival.Id, filmeFestival.Id)">
                                                                    @ObterTextoBotaoVoto(festival.Id, filmeFestival.Id)
                                                                </button>
                                                            </Authorized>
                                                            <NotAuthorized>
                                                                <a class="festival-vote-login"
                                                                   href="@GetLoginUrl()"
                                                                   @onclick:stopPropagation="true">
                                                                    Iniciar sessao
                                                                </a>
                                                            </NotAuthorized>
                                                        </AuthorizeView>
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="festival-muted mb-0">Este festival ainda nao tem filmes no catalogo.</p>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="festival-muted">Ainda nao existem festivais disponiveis.</p>
            }
        </div>

</section>

<AuthorizeView Roles="Admin">
    <Authorized>
        <section class="border rounded p-3">
            <h2 class="h4">Area reservada</h2>
            <p class="text-muted mb-3">A criacao de festivais fica disponivel apenas para utilizadores autenticados.</p>

            <button class="btn btn-primary mb-4" @onclick="AlternarFormulario">
                @(mostrarFormulario ? "Cancelar adicao de festival" : "Adicionar festival")
            </button>

            @if (mostrarFormulario)
            {
                <EditForm Model="form" OnValidSubmit="CriarFestival" Context="festivalEditContext"
                          class="border rounded p-3 mb-4">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="nome">Nome</label>
                        <InputText id="nome" class="form-control" @bind-Value="form.Nome"
                                   placeholder="Festival de Terror" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="genero">Genero</label>
                        <InputText id="genero" class="form-control" @bind-Value="form.Genero" placeholder="Terror" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="descricao">Descricao</label>
                        <InputTextArea id="descricao" class="form-control" @bind-Value="form.Descricao" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="dataInicio">Data de inicio</label>
                            <InputDate id="dataInicio" class="form-control" @bind-Value="form.DataInicio" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="dataFim">Data de fim</label>
                            <InputDate id="dataFim" class="form-control" @bind-Value="form.DataFim" />
                        </div>
                    </div>

                    <button class="btn btn-success" type="submit">Guardar</button>
                    <button class="btn btn-link" type="button" @onclick="EsconderFormulario">Cancelar</button>

                    <ValidationSummary class="text-danger mt-3" />
                </EditForm>
            }

            @if (!string.IsNullOrWhiteSpace(mensagem))
            {
                <div class="alert alert-success">@mensagem</div>
            }

            @if (!string.IsNullOrWhiteSpace(erro))
            {
                <div class="alert alert-danger">@erro</div>
            }

            <div class="border rounded p-3 mt-4">
                <h3 class="h5">Adicionar filme a festival</h3>

                @if (festivais.Count == 0)
                {
                    <p class="text-muted mb-0">Crie primeiro um festival para poder associar filmes.</p>
                }
                else
                {
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label" for="festival-filme">Festival</label>
                            <select id="festival-filme" class="form-select" @bind="filmeFestivalForm.FestivalId">
                                @foreach (var festival in festivais)
                                {
                                    <option value="@festival.Id">@festival.Nome</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label" for="titulo-filme-festival">Titulo do filme</label>
                            <input id="titulo-filme-festival" class="form-control" @bind="filmeFestivalForm.Titulo"
                                   placeholder="Inception" />
                        </div>

                        <div class="col-md-2 d-grid">
                            <button class="btn btn-success" type="button" @onclick="AdicionarFilmeAoFestival">
                                Adicionar
                            </button>
                        </div>
                    </div>
                }
            </div>
        </section>
    </Authorized>
</AuthorizeView>



@code {
    private const decimal PrecoPasseDiario = 9.99m;
    private const decimal PrecoPasseCompleto = 29.99m;
    private const decimal PrecoAluguerDigital = 14.99m;
    private const int HorasPadraoAluguerDigital = 48;

    private readonly FestivalForm form = new();
    private readonly FilmeFestivalForm filmeFestivalForm = new();
    private readonly Dictionary<int, CompraFestivalForm> comprasPorFestival = new();
    private readonly Dictionary<int, List<Filme>> filmesPorFestival = new();
    private readonly Dictionary<int, Dictionary<int, int>> votosPorFestival = new();
    private readonly Dictionary<int, int?> votoUtilizadorPorFestival = new();
    private readonly HashSet<int> catalogosAbertos = new();
    private readonly HashSet<int> catalogosACarregar = new();
    private List<Festival> festivais = new();
    private bool mostrarFormulario;
    private bool carregando;
    private string? mensagem;
    private string? mensagemCarrinho;
    private string? erro;

    private static readonly string[] FestivalImages =
    [
        "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=1800&q=85",
        "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1800&q=85",
        "https://images.unsplash.com/photo-1505686994434-e3cc5abf1330?auto=format&fit=crop&w=1800&q=85",
        "https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?auto=format&fit=crop&w=1800&q=85",
        "https://images.unsplash.com/photo-1503095396549-807759245b35?auto=format&fit=crop&w=1800&q=85",
        "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=1800&q=85"
    ];

    protected override async Task OnInitializedAsync()
    {
        await CarregarFestivais();
    }

    private void AlternarFormulario()
    {
        mostrarFormulario = !mostrarFormulario;
        mensagem = null;
        erro = null;

        if (!mostrarFormulario)
            form.Limpar();
    }

    private void EsconderFormulario()
    {
        mostrarFormulario = false;
    }

    private static string GetFestivalImage(int index)
    {
        return FestivalImages[index % FestivalImages.Length];
    }

    private async Task CarregarFestivais()
    {
        carregando = true;
        erro = null;

        festivais = (await FestivalCatalogService.ListarAsync()).ToList();

        foreach (var festival in festivais)
            ObterCompraFestival(festival);

        if (filmeFestivalForm.FestivalId == 0 && festivais.Count > 0)
            filmeFestivalForm.FestivalId = festivais[0].Id;

        carregando = false;
    }

    private async Task AlternarCatalogoFestival(int festivalId)
    {
        if (!catalogosAbertos.Add(festivalId))
        {
            catalogosAbertos.Remove(festivalId);
            catalogosACarregar.Remove(festivalId);
            return;
        }

        await CarregarCatalogoFestival(festivalId);
    }

    private async Task CarregarCatalogoFestival(int festivalId)
    {
        catalogosACarregar.Add(festivalId);
        filmesPorFestival[festivalId] = (await FestivalMovieService.ListarFilmesAsync(festivalId)).ToList();
        await CarregarVotosFestival(festivalId);
        catalogosACarregar.Remove(festivalId);
    }

    private async Task CarregarVotosFestival(int festivalId)
    {
        var resumo = await FestivalFavoriteVoteService.ListarResumoAsync(festivalId);
        votosPorFestival[festivalId] = resumo.ToDictionary(voto => voto.FilmeId, voto => voto.TotalVotos);

        var utilizadorId = await ObterUtilizadorIdAutenticado();
        votoUtilizadorPorFestival[festivalId] = utilizadorId.HasValue
            ? await FestivalFavoriteVoteService.ObterFilmeVotadoAsync(festivalId, utilizadorId.Value)
            : null;
    }

    private string ObterTextoBotaoCatalogo(int festivalId)
    {
        return catalogosAbertos.Contains(festivalId)
            ? "Esconder catalogo"
            : "Ver catalogo de filmes";
    }

    private CompraFestivalForm ObterCompraFestival(Festival festival)
    {
        if (!comprasPorFestival.TryGetValue(festival.Id, out var compra))
        {
            compra = new CompraFestivalForm
            {
                Tipo = TipoAcesso.PasseDiario,
                DiaFestival = DateTime.Today < festival.DataInicio.Date ? festival.DataInicio.Date : DateTime.Today
            };

            if (compra.DiaFestival > festival.DataFim.Date)
                compra.DiaFestival = festival.DataFim.Date;

            comprasPorFestival[festival.Id] = compra;
        }

        return compra;
    }

    private void AlterarTipoAcesso(int festivalId, string? valor)
    {
        if (!Enum.TryParse<TipoAcesso>(valor, out var tipo))
            return;

        comprasPorFestival[festivalId].Tipo = tipo;
    }

    private void AlterarDiaFestival(int festivalId, string? valor)
    {
        if (!DateTime.TryParse(valor, out var dia))
            return;

        var festival = festivais.FirstOrDefault(f => f.Id == festivalId);

        if (festival is not null)
        {
            if (dia.Date < festival.DataInicio.Date)
                dia = festival.DataInicio.Date;

            if (dia.Date > festival.DataFim.Date)
                dia = festival.DataFim.Date;
        }

        comprasPorFestival[festivalId].DiaFestival = dia.Date;
    }

    private void AlterarHorasAluguer(int festivalId, string? valor)
    {
        if (int.TryParse(valor, out var horas) && horas > 0)
            comprasPorFestival[festivalId].HorasAluguer = horas;
    }

    private async Task AdicionarAoCarrinho(Festival festival)
    {
        try
        {
            var utilizadorId = await ObterUtilizadorIdAutenticado();

            if (utilizadorId is null)
            {
                erro = "Tem de iniciar sessao para adicionar acessos ao carrinho.";
                return;
            }

            var compra = ObterCompraFestival(festival);
            var resultado = await CarrinhoService.AdicionarAcessoFestivalAsync(
                utilizadorId.Value,
                festival.Id,
                compra.Tipo,
                compra.DiaFestival,
                compra.HorasAluguer,
                ObterPreco(compra.Tipo));

            if (!resultado.Succeeded)
            {
                erro = resultado.ErrorMessage;
                mensagemCarrinho = null;
                return;
            }

            mensagemCarrinho = resultado.Value;
            erro = null;
        }
        catch (ArgumentException ex)
        {
            mensagemCarrinho = null;
            erro = ex.Message;
        }
    }

    private async Task<int?> ObterUtilizadorIdAutenticado()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.GetMadFlixUserId();
    }

    private async Task CriarFestival()
    {
        try
        {
            await FestivalCreationService.CriarAsync(
                form.Nome,
                form.Genero,
                form.DataInicio,
                form.DataFim,
                form.Descricao);

            form.Limpar();
            mostrarFormulario = false;
            mensagem = "Festival criado com sucesso.";

            await CarregarFestivais();
        }
        catch (ArgumentException ex)
        {
            erro = ex.Message;
        }
    }

    private async Task AdicionarFilmeAoFestival()
    {
        var resultado = await FestivalMovieService.AdicionarFilmeAsync(
            filmeFestivalForm.FestivalId,
            filmeFestivalForm.Titulo);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            mensagem = null;
            return;
        }

        mensagem = resultado.Value;
        erro = null;
        filmeFestivalForm.Titulo = string.Empty;

        if (catalogosAbertos.Contains(filmeFestivalForm.FestivalId))
            await CarregarCatalogoFestival(filmeFestivalForm.FestivalId);
    }

    private async Task VotarFilmeFavorito(int festivalId, int filmeId)
    {
        var utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            erro = "Tem de iniciar sessao para votar no filme favorito.";
            mensagem = null;
            return;
        }

        var resultado = await FestivalFavoriteVoteService.VotarAsync(
            festivalId,
            filmeId,
            utilizadorId.Value);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            mensagem = null;
            return;
        }

        mensagem = resultado.Value;
        erro = null;
        await CarregarVotosFestival(festivalId);
    }

    private int ObterTotalVotos(int festivalId, int filmeId)
    {
        return votosPorFestival.TryGetValue(festivalId, out var votosFestival) &&
            votosFestival.TryGetValue(filmeId, out var total)
                ? total
                : 0;
    }

    private string ObterTextoBotaoVoto(int festivalId, int filmeId)
    {
        return votoUtilizadorPorFestival.TryGetValue(festivalId, out var filmeVotadoId) &&
            filmeVotadoId == filmeId
                ? "Votado"
                : "Votar";
    }

    private string ObterClasseBotaoVoto(int festivalId, int filmeId)
    {
        var votado = votoUtilizadorPorFestival.TryGetValue(festivalId, out var filmeVotadoId) &&
            filmeVotadoId == filmeId;

        return votado
            ? "festival-vote-button festival-vote-button-active"
            : "festival-vote-button";
    }

    private void AbrirDetalhesFilme(int filmeId)
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.ToLocalPath());
        NavigationManager.NavigateTo($"/filmes/{filmeId}?returnUrl={returnUrl}");
    }

    private void AbrirDetalhesFilmeComTecla(KeyboardEventArgs args, int filmeId)
    {
        if (args.Key is "Enter" or " ")
            AbrirDetalhesFilme(filmeId);
    }

    private static IReadOnlyList<SessaoEstadoViewModel> ObterSessoesFestival(CompraFestivalForm compra)
    {
        if (compra.Tipo == TipoAcesso.AluguerDigital)
            return ObterSessoesAluguerDigital(compra.HorasAluguer);

        var dia = compra.Tipo == TipoAcesso.PasseDiario
            ? compra.DiaFestival
            : DateTime.Today;

        return SessaoFestivalCatalog.SessoesPasseDiario
            .Select(sessao =>
            {
                var inicio = sessao.ObterInicio(dia);
                var fim = sessao.ObterFim(dia);
                var estado = new SessaoEstadoContext(inicio, fim, DateTime.Now);

                return new SessaoEstadoViewModel
                {
                    Nome = sessao.Nome,
                    Inicio = inicio,
                    Fim = fim,
                    Estado = estado.Nome,
                    ClasseCss = estado.ClasseCss,
                    Disponivel = estado.Disponivel
                };
            })
            .ToList();
    }

    private static IReadOnlyList<SessaoEstadoViewModel> ObterSessoesAluguerDigital(int horasAluguer)
    {
        var inicioAluguer = DateTime.Now;
        var fimAluguer = inicioAluguer.AddHours(horasAluguer);
        var sessoes = new List<SessaoEstadoViewModel>();

        for (var dia = inicioAluguer.Date; dia <= fimAluguer.Date; dia = dia.AddDays(1))
        {
            foreach (var sessao in SessaoFestivalCatalog.SessoesPasseDiario)
            {
                var inicioSessao = sessao.ObterInicio(dia);
                var fimSessao = sessao.ObterFim(dia);
                var inicioCoberto = inicioAluguer > inicioSessao ? inicioAluguer : inicioSessao;
                var fimCoberto = fimAluguer < fimSessao ? fimAluguer : fimSessao;

                if (inicioCoberto >= fimCoberto)
                    continue;

                var estado = new SessaoEstadoContext(inicioCoberto, fimCoberto, DateTime.Now);

                sessoes.Add(new SessaoEstadoViewModel
                {
                    Nome = sessao.Nome,
                    Inicio = inicioCoberto,
                    Fim = fimCoberto,
                    Estado = estado.Nome,
                    ClasseCss = estado.ClasseCss,
                    Disponivel = estado.Disponivel
                });
            }
        }

        return sessoes.Count > 0
            ? sessoes
            :
            [
                new SessaoEstadoViewModel
                {
                    Nome = "Sem sessao coberta",
                    Inicio = inicioAluguer,
                    Fim = fimAluguer,
                    Estado = "Indisponivel",
                    ClasseCss = "session-state unavailable",
                    Disponivel = false
                }
            ];
    }

    private static string ObterDescricaoTipo(TipoAcesso tipo)
    {
        return tipo switch
        {
            TipoAcesso.PasseDiario => "Passe diario",
            TipoAcesso.PasseCompleto => "Passe completo",
            TipoAcesso.AluguerDigital => "Aluguer digital",
            TipoAcesso.BilheteSessao => "Bilhete de sessao",
            _ => "Acesso"
        };
    }

    private static decimal ObterPreco(TipoAcesso tipo)
    {
        return tipo switch
        {
            TipoAcesso.PasseDiario => PrecoPasseDiario,
            TipoAcesso.PasseCompleto => PrecoPasseCompleto,
            TipoAcesso.AluguerDigital => PrecoAluguerDigital,
            _ => throw new InvalidOperationException("Tipo de acesso invalido para festival.")
        };
    }

