@page "/filmes/{FilmeId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@inject IFilmeCatalogService FilmeCatalogService
@inject IComentarioFilmeService ComentarioFilmeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(filme?.Titulo ?? "Filme")</PageTitle>

@if (carregando)
{
    <p>A carregar filme...</p>
}
else if (!string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-danger">@erro</div>
    <button class="btn btn-outline-secondary" type="button" @onclick="Voltar">
        Voltar
    </button>
}
else if (filme is not null)
{
    <article class="movie-detail">
        <div class="movie-poster-panel">
            @if (!string.IsNullOrWhiteSpace(filme.Poster) && filme.Poster != "N/A")
            {
                <img src="@filme.Poster" alt="@filme.Titulo" />
            }
            else
            {
                <div class="movie-poster-placeholder">@filme.Titulo</div>
            }

            <dl class="movie-facts">
                @if (!string.IsNullOrWhiteSpace(filme.Genero))
                {
                    <div>
                        <dt>Genero</dt>
                        <dd>@filme.Genero</dd>
                    </div>
                }

                @if (filme.ImdbRating.HasValue)
                {
                    <div>
                        <dt>Avaliacao</dt>
                        <dd>@filme.ImdbRating.Value.ToString("0.0")</dd>
                    </div>
                }

                @if (filme.Diretor is not null)
                {
                    <div>
                        <dt>Diretor</dt>
                        <dd>@filme.Diretor.Nome</dd>
                    </div>
                }

                @if (filme.Festival is not null)
                {
                    <div>
                        <dt>Festival</dt>
                        <dd>@filme.Festival.Nome</dd>
                    </div>
                }
            </dl>
        </div>

        <section class="movie-info">
            <button class="btn btn-link px-0" type="button" @onclick="Voltar">
                Voltar
            </button>

            <h1>@filme.Titulo</h1>

            <div class="movie-meta">
                @if (filme.Ano > 0)
                {
                    <span>@filme.Ano</span>
                }

                @if (!string.IsNullOrWhiteSpace(filme.Runtime))
                {
                    <span>@filme.Runtime</span>
                }

                @if (!string.IsNullOrWhiteSpace(filme.Rated))
                {
                    <span>@filme.Rated</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(filme.Sinopse))
            {
                <p class="movie-overview">@filme.Sinopse</p>
            }

            @if (TemTrailer)
            {
                <section class="movie-player">
                    <h2>Ver filme</h2>

                    @if (!string.IsNullOrWhiteSpace(trailerEmbedUrl))
                    {
                        <iframe src="@trailerEmbedUrl"
                                title="Trailer de @filme.Titulo"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                    }
                    else
                    {
                        <a class="btn btn-light" href="@filme.TrailerUrl" target="_blank" rel="noopener noreferrer">
                            Ver filme
                        </a>
                    }
                </section>
            }

            @if (atores.Count > 0)
            {
                <section class="movie-cast">
                    <h2>Elenco</h2>
                    <div class="cast-list">
                        @foreach (var filmeAtor in atores)
                        {
                            <span>
                                @filmeAtor.Ator.Nome
                                @if (!string.IsNullOrWhiteSpace(filmeAtor.Papel))
                                {
                                    <small>@filmeAtor.Papel</small>
                                }
                            </span>
                        }
                    </div>
                </section>
            }

            <section class="movie-comments">
                <h2>Comentarios</h2>

                @if (!string.IsNullOrWhiteSpace(mensagemComentario))
                {
                    <div class="alert alert-success">@mensagemComentario</div>
                }

                @if (!string.IsNullOrWhiteSpace(erroComentario))
                {
                    <div class="alert alert-danger">@erroComentario</div>
                }

                <AuthorizeView>
                    <Authorized>
                        <div class="comment-form">
                            <div class="star-picker" aria-label="Avaliacao">
                                @for (var estrela = 1; estrela <= 5; estrela++)
                                {
                                    var valorEstrela = estrela;
                                    <button class="star-button"
                                            type="button"
                                            title="@($"{valorEstrela} estrelas")"
                                            @onclick="() => comentarioForm.Estrelas = valorEstrela">
                                        @(valorEstrela <= comentarioForm.Estrelas ? "★" : "☆")
                                    </button>
                                }
                            </div>

                            <textarea class="form-control"
                                      rows="3"
                                      maxlength="600"
                                      @bind="comentarioForm.Texto"
                                      placeholder="Escreve a tua opiniao sobre o filme"></textarea>

                            <button class="btn btn-light" type="button" @onclick="AdicionarComentario">
                                Publicar comentario
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <p>Inicie sessao para comentar e avaliar este filme.</p>
                    </NotAuthorized>
                </AuthorizeView>

                @if (comentarios.Count == 0)
                {
                    <p>Ainda nao existem comentarios para este filme.</p>
                }
                else
                {
                    <div class="comment-list">
                        @foreach (var comentario in comentarios)
                        {
                            <article class="comment-item">
                                <div>
                                    <strong>@(comentario.Utilizador?.NomeUtilizador ?? "Utilizador")</strong>
                                    <span>@ObterEstrelas(comentario.Estrelas)</span>
                                    <small>@comentario.CriadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p>@comentario.Texto</p>
                                <button class="btn btn-sm btn-danger"
                                        type="button"
                                        @onclick="() => RemoverComentario(comentario.Id)">
                                    Remover
                                </button>
                            </article>
                        }
                    </div>
                }
            </section>
        </section>
    </article>
}

<style>
    .movie-detail {
        display: grid;
        gap: 2rem;
        grid-template-columns: minmax(220px, 360px) minmax(0, 1fr);
        margin: 1rem auto;
        max-width: 1120px;
    }

    .movie-poster-panel img,
    .movie-poster-placeholder {
        aspect-ratio: 2 / 3;
        border-radius: .5rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .22);
        width: 100%;
    }

    .movie-poster-panel img {
        object-fit: cover;
    }

    .movie-poster-placeholder {
        align-items: center;
        background: #78000f;
        color: #fff;
        display: flex;
        font-size: 1.4rem;
        font-weight: 700;
        justify-content: center;
        padding: 1.5rem;
        text-align: center;
    }

    .movie-info h1 {
        font-size: 2.4rem;
        margin: .25rem 0 .75rem;
    }

    .movie-meta {
        color: #e9eef7;
        display: flex;
        flex-wrap: wrap;
        font-weight: 700;
        gap: .5rem;
        margin-bottom: 1.25rem;
    }

    .movie-meta span:not(:last-child)::after {
        content: "•";
        color: rgba(255, 255, 255, .75);
        margin-left: .5rem;
    }

    .movie-overview {
        font-size: 1.05rem;
        line-height: 1.65;
        max-width: 760px;
    }

    .movie-player {
        margin-top: 1.25rem;
    }

    .movie-player h2 {
        font-size: 1.1rem;
        margin-bottom: .75rem;
    }

    .movie-player iframe {
        aspect-ratio: 16 / 9;
        border: 0;
        border-radius: .5rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, .22);
        width: 100%;
    }

    .movie-facts {
        display: grid;
        gap: .9rem;
        grid-template-columns: 1fr;
        margin: 1.25rem 0 0;
    }

    .movie-facts div {
        border-top: 1px solid rgba(255, 255, 255, .7);
        padding-top: .75rem;
    }

    .movie-facts dt {
        color: #dbeafe;
        font-size: .85rem;
        font-weight: 600;
        margin-bottom: .2rem;
    }

    .movie-facts dd {
        color: #ffffff;
        font-weight: 700;
        margin: 0;
    }

    .movie-cast h2 {
        font-size: 1.35rem;
        margin-bottom: .75rem;
    }

    .cast-list {
        display: flex;
        flex-wrap: wrap;
        gap: .55rem;
    }

    .cast-list span {
        background: #ffffff;
        border-radius: 999px;
        color: #7f0011;
        display: inline-flex;
        gap: .35rem;
        font-weight: 700;
        padding: .45rem .75rem;
    }

    .cast-list small {
        color: #475467;
    }

    .movie-comments {
        margin-top: 2rem;
        max-width: 760px;
    }

    .movie-comments h2 {
        font-size: 1.35rem;
        margin-bottom: .75rem;
    }

    .comment-form,
    .comment-list {
        display: grid;
        gap: .75rem;
    }

    .comment-form {
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .35);
        border-radius: .5rem;
        margin-bottom: 1rem;
        padding: .85rem;
    }

    .star-picker {
        display: flex;
        gap: .25rem;
    }

    .star-button {
        background: transparent;
        border: 0;
        color: #ffe066;
        font-size: 1.7rem;
        line-height: 1;
        padding: 0;
    }

    .comment-item {
        background: #ffffff;
        border-radius: .5rem;
        color: #7f0011;
        padding: .85rem;
    }

    .comment-item div {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: .65rem;
    }

    .comment-item span {
        color: #f59f00;
    }

    .comment-item small {
        color: #667085;
    }

    .comment-item p {
        color: #101828;
        margin: .65rem 0;
    }

    @@media (max-width: 768px) {
        .movie-detail {
            grid-template-columns: 1fr;
        }

        .movie-poster-panel {
            max-width: 260px;
        }

        .movie-info h1 {
            font-size: 1.8rem;
        }
    }
</style>

@code {
    [Parameter]
    public int FilmeId { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private Filme? filme;
    private List<FilmeAtor> atores = new();
    private List<ComentarioFilme> comentarios = new();
    private readonly ComentarioForm comentarioForm = new();
    private string? trailerEmbedUrl;
    private bool carregando = true;
    private string? erro;
    private string? mensagemComentario;
    private string? erroComentario;

    private bool TemTrailer => !string.IsNullOrWhiteSpace(filme?.TrailerUrl);

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        erro = null;

        var resultado = await FilmeCatalogService.ObterDetalhesAsync(FilmeId);

        if (!resultado.Succeeded || resultado.Value is null)
        {
            erro = resultado.ErrorMessage;
            carregando = false;
            return;
        }

        filme = resultado.Value;
        trailerEmbedUrl = ObterYoutubeEmbedUrl(filme.TrailerUrl);
        atores = filme.FilmeAtores
            .Where(filmeAtor => filmeAtor.Ator is not null)
            .OrderBy(filmeAtor => filmeAtor.Ator.Nome)
            .ToList();
        await CarregarComentarios();
        carregando = false;
    }

    private async Task CarregarComentarios()
    {
        comentarios = (await ComentarioFilmeService.ListarPorFilmeAsync(FilmeId)).ToList();
    }

    private async Task AdicionarComentario()
    {
        mensagemComentario = null;
        erroComentario = null;

        var utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            erroComentario = "Tem de iniciar sessao para comentar.";
            return;
        }

        var resultado = await ComentarioFilmeService.AdicionarAsync(
            FilmeId,
            utilizadorId.Value,
            comentarioForm.Estrelas,
            comentarioForm.Texto);

        if (!resultado.Succeeded)
        {
            erroComentario = resultado.ErrorMessage;
            return;
        }

        mensagemComentario = resultado.Value;
        comentarioForm.Limpar();
        await CarregarComentarios();
    }

    private async Task RemoverComentario(int comentarioId)
    {
        mensagemComentario = null;
        erroComentario = null;

        var resultado = await ComentarioFilmeService.RemoverAsync(comentarioId);

        if (!resultado.Succeeded)
        {
            erroComentario = resultado.ErrorMessage;
            return;
        }

        mensagemComentario = resultado.Value;
        await CarregarComentarios();
    }

    private async Task<int?> ObterUtilizadorIdAutenticado()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.GetMadFlixUserId();
    }

    private void Voltar()
    {
        NavigationManager.NavigateTo(NavigationHelpers.NormalizeReturnUrl(ReturnUrl));
    }

    private static string? ObterYoutubeEmbedUrl(string? trailerUrl)
    {
        if (string.IsNullOrWhiteSpace(trailerUrl) ||
            !Uri.TryCreate(trailerUrl, UriKind.Absolute, out var uri))
        {
            return null;
        }

        var host = uri.Host.ToLowerInvariant();

        if (host.Contains("youtu.be"))
        {
            var videoId = uri.AbsolutePath.Trim('/');
            return string.IsNullOrWhiteSpace(videoId)
                ? null
                : $"https://www.youtube.com/embed/{videoId}";
        }

        if (host.Contains("youtube.com"))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var videoId = query["v"];
            return string.IsNullOrWhiteSpace(videoId)
                ? null
                : $"https://www.youtube.com/embed/{videoId}";
        }

        return null;
    }

    private static string ObterEstrelas(int estrelas)
    {
        var valor = Math.Clamp(estrelas, 1, 5);
        return new string('★', valor) + new string('☆', 5 - valor);
    }

    private sealed class ComentarioForm
    {
        public int Estrelas { get; set; } = 5;
        public string Texto { get; set; } = string.Empty;

        public void Limpar()
        {
            Estrelas = 5;
            Texto = string.Empty;
        }
    }
}
