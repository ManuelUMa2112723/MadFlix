@page "/ator"
@rendermode InteractiveServer
@using MadFlix.Models
@using MadFlix.Services
@inject FilmeService FilmeService

<PageTitle>@(nomeAtor ?? "Ator")</PageTitle>

@if (carregando)
{
    <p>A pesquisar ator...</p>
}
else if (erro != null)
{
    <div class="alert alert-danger">@erro</div>
}
else
{
    <h1>@nomeAtor</h1>

    @if (filmes.Count > 0)
    {
        <div class="movie-grid">
            @foreach (var filme in filmes)
            {
                <article class="movie-card">
                    @if (!string.IsNullOrWhiteSpace(filme.PosterPath))
                    {
                        <img src="https://image.tmdb.org/t/p/w500@(filme.PosterPath)" alt="@filme.Title" />
                    }
                    else
                    {
                        <div class="movie-card-placeholder">@filme.Title</div>
                    }
                    <div class="movie-card-body">
                        <h3>@filme.Title</h3>
                        <p>@filme.ReleaseDate</p>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p>Nenhum filme encontrado para este ator.</p>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "nome")]
    public string? Nome { get; set; }

    private string? nomeAtor;
    private List<TmdbFilmeResumo> filmes = new();
    private bool carregando = true;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Nome))
        {
            erro = "Nome do ator não fornecido.";
            carregando = false;
            return;
        }

        var resultado = await FilmeService.BuscarFilmesPorAtorAsync(Nome);

        if (resultado == null)
        {
            erro = $"Ator '{Nome}' não encontrado.";
        }
        else
        {
            nomeAtor = resultado.Value.Nome;
            filmes = resultado.Value.Filmes;
        }

        carregando = false;
    }
}
