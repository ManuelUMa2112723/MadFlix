@page "/perfil"
@rendermode InteractiveServer
@using System.Collections.Generic
@using System.Security.Claims
@using MadFlix.Models
@using MadFlix.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IListaPessoalService ListaPessoalService
@inject IUserPasswordService PasswordService
@inject NavigationManager NavigationManager

<PageTitle>Perfil</PageTitle>

<h1>Perfil</h1>

<AuthorizeView Roles="User,Admin">
    <Authorized Context="authState">

        <section class="border rounded p-3 mb-4">
            <h2 class="h4">Informacao basica</h2>
            <p><strong>Nome:</strong> @authState.User.Identity?.Name</p>
            <p><strong>Email:</strong> @authState.User.FindFirst(ClaimTypes.Email)?.Value</p>
        </section>

        <section class="border rounded p-3 mb-4">
            <h2 class="h4">Alterar password</h2>

            @if (isAdmin)
            {
                @if (!string.IsNullOrWhiteSpace(passwordMensagem))
                {
                    <div class="alert alert-success">@passwordMensagem</div>
                }

                @if (!string.IsNullOrWhiteSpace(passwordErro))
                {
                    <div class="alert alert-danger">@passwordErro</div>
                }

                <div class="mb-3">
                    <label for="currentPassword" class="form-label">Password atual</label>
                    <input id="currentPassword" class="form-control" type="password" @bind="currentPassword" />
                </div>
                <div class="mb-3">
                    <label for="newPassword" class="form-label">Nova password</label>
                    <input id="newPassword" class="form-control" type="password" minlength="6" @bind="newPassword" />
                </div>
                <div class="mb-3">
                    <label for="confirmarPassword" class="form-label">Confirmar password</label>
                    <input id="confirmarPassword" class="form-control" type="password" minlength="6" @bind="confirmarPassword" />
                </div>
                <button class="btn btn-primary" @onclick="AlterarPassword" disabled="@passwordChanging">Alterar password</button>
            }
            else
            {
                <p class="text-muted">Apenas administradores podem alterar a password.</p>
            }
        </section>

        <section class="border rounded p-3 mb-4">
            <h2 class="h4">Listas pessoais</h2>

            <div class="d-flex gap-2 mb-3">
                <input class="form-control" style="max-width: 300px;"
                       @bind="nomeLista"
                       placeholder="Nome da nova lista..." />
                <button class="btn btn-primary" @onclick="CriarLista">
                    Criar lista
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensagem))
            {
                <div class="alert alert-success">@mensagem</div>
            }

            @if (!string.IsNullOrWhiteSpace(erro))
            {
                <div class="alert alert-danger">@erro</div>
            }

            @if (carregando)
            {
                <p>A carregar listas...</p>
            }
            else if (listas.Count == 0)
            {
                <p class="text-muted">Ainda nao tem listas pessoais.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var lista in listas)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <h3 class="h6 mb-0">@lista.Nome</h3>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => EliminarLista(lista.Id)">
                                    Eliminar
                                </button>
                            </div>

                            @if (lista.ListaPessoalFilmes.Count > 0)
                            {
                                <ul class="mt-2 mb-0">
                                    @foreach (var lf in lista.ListaPessoalFilmes)
                                    {
                                        <li class="d-flex justify-content-between align-items-center">
                                            <span>@lf.Filme.Titulo (@lf.Filme.Ano)</span>
                                            <button class="btn btn-sm btn-link text-danger"
                                                    @onclick="() => RemoverFilme(lista.Id, lf.FilmeId)">
                                                Remover
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted mt-2 mb-0 small">Esta lista ainda nao tem filmes.</p>
                            }
                        </div>
                    }
                </div>
            }
        </section>

    </Authorized>
    <NotAuthorized>
        <p>Tem de iniciar sessao para aceder ao perfil.</p>
        <a href="/login" class="btn btn-primary">Iniciar sessao</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ListaPessoal> listas = new();
    private string nomeLista = string.Empty;
    private bool carregando = true;
    private string? mensagem;
    private string? erro;
    private int utilizadorId;
    private bool isAdmin;
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmarPassword = string.Empty;
    private string? passwordMensagem;
    private string? passwordErro;
    private bool passwordChanging;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isAdmin = authState.User.IsInRole("Admin");

        if (int.TryParse(idClaim, out var id))
        {
            utilizadorId = id;
            await CarregarListas();
        }

        carregando = false;
    }

    private async Task CarregarListas()
    {
        listas = (await ListaPessoalService.ListarAsync(utilizadorId)).ToList();
    }

    private async Task CriarLista()
    {
        mensagem = null;
        erro = null;

        var resultado = await ListaPessoalService.CriarAsync(utilizadorId, nomeLista);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        nomeLista = string.Empty;
        mensagem = "Lista criada com sucesso.";
        await CarregarListas();
    }

    private async Task EliminarLista(int listaId)
    {
        mensagem = null;
        erro = null;

        var resultado = await ListaPessoalService.EliminarAsync(listaId, utilizadorId);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        mensagem = "Lista eliminada com sucesso.";
        await CarregarListas();
    }

    private async Task RemoverFilme(int listaId, int filmeId)
    {
        mensagem = null;
        erro = null;

        var resultado = await ListaPessoalService.RemoverFilmeAsync(listaId, filmeId, utilizadorId);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        mensagem = "Filme removido da lista.";
        await CarregarListas();
    }

    private async Task AlterarPassword()
    {
        passwordMensagem = null;
        passwordErro = null;

        if (!isAdmin)
        {
            passwordErro = "Apenas administradores podem alterar a password.";
            return;
        }

        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmarPassword))
        {
            passwordErro = "Preencha todos os campos.";
            return;
        }

        if (newPassword.Length < 6)
        {
            passwordErro = "A password tem de ter pelo menos 6 caracteres.";
            return;
        }

        if (newPassword != confirmarPassword)
        {
            passwordErro = "As passwords nao coincidem.";
            return;
        }

        passwordChanging = true;

        try
        {
            var result = await PasswordService.ChangePasswordAsync(
                utilizadorId,
                currentPassword,
                newPassword);

            if (!result.Succeeded)
            {
                passwordErro = result.ErrorMessage ?? "Nao foi possivel alterar a password.";
            }
            else
            {
                passwordMensagem = "Password alterada com sucesso.";
                currentPassword = string.Empty;
                newPassword = string.Empty;
                confirmarPassword = string.Empty;
            }
        }
        catch
        {
            passwordErro = "Erro ao tentar alterar a password.";
        }
        finally
        {
            passwordChanging = false;
        }
    }
}