@page "/perfil"
@rendermode InteractiveServer
@using System.Collections.Generic
@using System.Security.Claims
@using MadFlix.Contracts.Profile
@using MadFlix.Models
@using MadFlix.Services
@using MadFlix.Services.Profile
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IListaPessoalService ListaPessoalService
@inject IUserPasswordService PasswordService
@inject IUserProfilePhotoChangeNotifier ProfilePhotoChangeNotifier
@inject IUserProfilePhotoService ProfilePhotoService
@inject NavigationManager NavigationManager

<PageTitle>Perfil</PageTitle>

<AuthorizeView Roles="User,Admin">
    <Authorized Context="authState">
        <section class="profile-hero" aria-labelledby="profile-title">
            @if (!string.IsNullOrWhiteSpace(fotoPerfilUrl))
            {
                <img class="profile-avatar-large profile-avatar-image"
                     src="@fotoPerfilUrl"
                     alt="Foto de perfil de @authState.User.Identity?.Name" />
            }
            else
            {
                <div class="profile-avatar-large" aria-hidden="true">
                    @GetUserInitials(authState.User.Identity?.Name)
                </div>
            }
            <div>
                <p class="profile-kicker">Minha conta</p>
                <h1 id="profile-title">Perfil</h1>
                <p>Gere os teus dados, listas pessoais e definicoes de acesso MadFlix.</p>
            </div>
        </section>

        <section class="profile-card">
            <h2>Informacao basica</h2>
            <div class="profile-info-grid">
                <div>
                    <span>Nome</span>
                    <strong>@authState.User.Identity?.Name</strong>
                </div>
                <div>
                    <span>Email</span>
                    <strong>@authState.User.FindFirst(ClaimTypes.Email)?.Value</strong>
                </div>
            </div>
        </section>

        <section class="profile-card">
            <h2>Foto de perfil</h2>

            @if (!string.IsNullOrWhiteSpace(fotoMensagem))
            {
                <div class="alert alert-success">@fotoMensagem</div>
            }

            @if (!string.IsNullOrWhiteSpace(fotoErro))
            {
                <div class="alert alert-danger">@fotoErro</div>
            }

            <div class="profile-photo-editor">
                @if (!string.IsNullOrWhiteSpace(fotoPerfilUrl))
                {
                    <img class="profile-photo-preview" src="@fotoPerfilUrl" alt="Foto de perfil atual" />
                }
                else
                {
                    <div class="profile-photo-preview profile-photo-fallback" aria-hidden="true">
                        @GetUserInitials(authState.User.Identity?.Name)
                    </div>
                }

                <div class="profile-photo-controls">
                    <label class="form-label" for="profilePhoto">Escolher imagem</label>
                    <InputFile id="profilePhoto"
                               class="form-control"
                               accept="image/jpeg,image/png,image/webp"
                               OnChange="AlterarFotoPerfil" />
                    <p class="profile-muted">Formatos permitidos: JPG, PNG ou WebP. A imagem e comprimida automaticamente.</p>
                </div>
            </div>
        </section>

        <section class="profile-card">
            <h2>Alterar password</h2>

            @if (!string.IsNullOrWhiteSpace(passwordMensagem))
            {
                <div class="alert alert-success">@passwordMensagem</div>
            }

            @if (!string.IsNullOrWhiteSpace(passwordErro))
            {
                <div class="alert alert-danger">@passwordErro</div>
            }

            <div class="mb-3">
                <label for="currentPassword" class="form-label">Password atual</label>
                <input id="currentPassword" class="form-control" type="password" @bind="currentPassword" />
            </div>
            <div class="mb-3">
                <label for="newPassword" class="form-label">Nova password</label>
                <input id="newPassword" class="form-control" type="password" minlength="6" @bind="newPassword" />
            </div>
            <div class="mb-3">
                <label for="confirmarPassword" class="form-label">Confirmar password</label>
                <input id="confirmarPassword" class="form-control" type="password" minlength="6" @bind="confirmarPassword" />
            </div>
            <button class="btn btn-primary" @onclick="AlterarPassword" disabled="@passwordChanging">Alterar password</button>
        </section>

        <section class="profile-card">
            <h2>Listas pessoais</h2>

            <div class="profile-list-form">
                <input class="form-control"
                       @bind="nomeLista"
                       placeholder="Nome da nova lista..." />
                <button class="btn btn-primary" @onclick="CriarLista">
                    Criar lista
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensagem))
            {
                <div class="alert alert-success">@mensagem</div>
            }

            @if (!string.IsNullOrWhiteSpace(erro))
            {
                <div class="alert alert-danger">@erro</div>
            }

            @if (carregando)
            {
                <p>A carregar listas...</p>
            }
            else if (listas.Count == 0)
            {
                <p class="profile-muted">Ainda nao tem listas pessoais.</p>
            }
            else
            {
                <div class="profile-lists">
                    @foreach (var lista in listas)
                    {
                        <article class="profile-list-item">
                            <div class="profile-list-header">
                                <h3>@lista.Nome</h3>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => EliminarLista(lista.Id)">
                                    Eliminar
                                </button>
                            </div>

                            @if (lista.ListaPessoalFilmes.Count > 0)
                            {
                                <ul class="mt-2 mb-0">
                                    @foreach (var lf in lista.ListaPessoalFilmes)
                                    {
                                        <li class="d-flex justify-content-between align-items-center">
                                            <span>@lf.Filme.Titulo (@lf.Filme.Ano)</span>
                                            <button class="btn btn-sm btn-link text-danger"
                                                    @onclick="() => RemoverFilme(lista.Id, lf.FilmeId)">
                                                Remover
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="profile-muted small mb-0">Esta lista ainda nao tem filmes.</p>
                            }
                        </article>
                    }
                </div>
            }
        </section>

    </Authorized>
    <NotAuthorized>
        <p>Tem de iniciar sessao para aceder ao perfil.</p>
        <a href="/login" class="btn btn-primary">Iniciar sessao</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ListaPessoal> listas = new();
    private string nomeLista = string.Empty;
    private bool carregando = true;
    private string? mensagem;
    private string? erro;
    private int utilizadorId;
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmarPassword = string.Empty;
    private string? passwordMensagem;
    private string? passwordErro;
    private bool passwordChanging;
    private string? fotoPerfilUrl;
    private string? fotoMensagem;
    private string? fotoErro;
    private const int FotoPerfilMaxWidth = 512;
    private const int FotoPerfilMaxHeight = 512;
    private const string FotoPerfilContentType = "image/jpeg";

    private static string GetUserInitials(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "U";

        var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
            return "U";

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (int.TryParse(idClaim, out var id))
        {
            utilizadorId = id;
            fotoPerfilUrl = await ProfilePhotoService.GetPhotoUrlAsync(utilizadorId);
            await CarregarListas();
        }

        carregando = false;
    }

    private async Task CarregarListas()
    {
        listas = (await ListaPessoalService.ListarAsync(utilizadorId)).ToList();
    }

    private async Task CriarLista()
    {
        mensagem = null;
        erro = null;

        var resultado = await ListaPessoalService.CriarAsync(utilizadorId, nomeLista);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        nomeLista = string.Empty;
        mensagem = "Lista criada com sucesso.";
        await CarregarListas();
    }

    private async Task EliminarLista(int listaId)
    {
        mensagem = null;
        erro = null;

        var resultado = await ListaPessoalService.EliminarAsync(listaId, utilizadorId);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        mensagem = "Lista eliminada com sucesso.";
        await CarregarListas();
    }

    private async Task RemoverFilme(int listaId, int filmeId)
    {
        mensagem = null;
        erro = null;

        var resultado = await ListaPessoalService.RemoverFilmeAsync(listaId, filmeId, utilizadorId);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            return;
        }

        mensagem = "Filme removido da lista.";
        await CarregarListas();
    }

    private async Task AlterarPassword()
    {
        passwordMensagem = null;
        passwordErro = null;

        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmarPassword))
        {
            passwordErro = "Preencha todos os campos.";
            return;
        }

        if (newPassword.Length < 6)
        {
            passwordErro = "A password tem de ter pelo menos 6 caracteres.";
            return;
        }

        if (newPassword != confirmarPassword)
        {
            passwordErro = "As passwords nao coincidem.";
            return;
        }

        passwordChanging = true;

        try
        {
            var result = await PasswordService.ChangePasswordAsync(
                utilizadorId,
                currentPassword,
                newPassword);

            if (!result.Succeeded)
            {
                passwordErro = result.ErrorMessage ?? "Nao foi possivel alterar a password.";
            }
            else
            {
                passwordMensagem = "Password alterada com sucesso.";
                currentPassword = string.Empty;
                newPassword = string.Empty;
                confirmarPassword = string.Empty;
            }
        }
        catch
        {
            passwordErro = "Erro ao tentar alterar a password.";
        }
        finally
        {
            passwordChanging = false;
        }
    }

    private async Task AlterarFotoPerfil(InputFileChangeEventArgs args)
    {
        fotoMensagem = null;
        fotoErro = null;

        var file = args.File;

        if (file is null)
        {
            fotoErro = "Escolha uma imagem para atualizar a foto de perfil.";
            return;
        }

        try
        {
            var compressedFile = await file.RequestImageFileAsync(
                FotoPerfilContentType,
                FotoPerfilMaxWidth,
                FotoPerfilMaxHeight);

            if (compressedFile.Size > ProfilePhotoService.MaxFileSizeBytes)
            {
                fotoErro = "A imagem comprimida deve ter no maximo 2 MB.";
                return;
            }

            await using var stream = compressedFile.OpenReadStream(ProfilePhotoService.MaxFileSizeBytes);
            var upload = new ProfilePhotoUpload(
                stream,
                compressedFile.Name,
                compressedFile.ContentType,
                compressedFile.Size);

            var resultado = await ProfilePhotoService.ChangePhotoAsync(utilizadorId, upload);

            if (!resultado.Succeeded || string.IsNullOrWhiteSpace(resultado.Value))
            {
                fotoErro = resultado.ErrorMessage ?? "Nao foi possivel atualizar a foto de perfil.";
                return;
            }

            fotoPerfilUrl = resultado.Value;
            ProfilePhotoChangeNotifier.NotifyChanged(utilizadorId, fotoPerfilUrl);
            fotoMensagem = "Foto de perfil atualizada com sucesso.";
        }
        catch
        {
            fotoErro = "Erro ao atualizar a foto de perfil.";
        }
    }
}
