@implements IDisposable
@rendermode InteractiveServer
@using MadFlix.Models.Acessos
@using MadFlix.Models.Pagamentos.StatesPagamento
@using MadFlix.Models.Pagamentos.StrategiesPagamento
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICarrinhoService CarrinhoService

<AuthorizeView>
    <Authorized>
        <button class="cart-button" type="button" title="Carrinho" @onclick="AbrirCarrinho">
            <svg class="cart-icon" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M6.2 6.5h14.1l-1.6 7.1a2 2 0 0 1-2 1.6H9.3a2 2 0 0 1-2-1.6L5.5 3.8H3.2" />
                <path d="M9.2 19.5h.1" />
                <path d="M17.2 19.5h.1" />
            </svg>
            @if (itens.Count > 0)
            {
                <span class="cart-count">@itens.Count</span>
            }
        </button>

        @if (aberto)
        {
            <div class="cart-backdrop" @onclick="FecharCarrinho"></div>
            <aside class="cart-drawer" aria-label="Carrinho">
                <div class="cart-header">
                    <div>
                        <h2>Carrinho</h2>
                        <span>@itens.Count item(s)</span>
                    </div>
                    <button class="btn-close" type="button" aria-label="Fechar" @onclick="FecharCarrinho"></button>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensagem))
                {
                    <div class="alert alert-success">@mensagem</div>
                }

                @if (!string.IsNullOrWhiteSpace(erro))
                {
                    <div class="alert alert-danger">@erro</div>
                }

                @if (aCarregar)
                {
                    <p>A carregar carrinho...</p>
                }
                else if (itens.Count == 0)
                {
                    <p class="cart-empty">Ainda nao adicionaste acessos ao carrinho.</p>
                }
                else
                {
                    <div class="cart-items">
                        @foreach (var item in itens)
                        {
                            <div class="cart-item">
                                <div>
                                    <strong>@ObterNomeItem(item)</strong>
                                    <span>@ObterDescricaoTipo(item.TipoAcesso)</span>
                                    <small>
                                        @item.InicioAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        -
                                        @item.FimAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                    <strong>@item.Preco.ToString("C")</strong>
                                </div>
                                <button class="btn btn-sm btn-outline-danger"
                                        type="button"
                                        @onclick="() => RemoverItem(item.Id)">
                                    Remover
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (mostrarPagamento)
                {
                    <section class="payment-panel" aria-label="Pagamento">
                        <h3>Metodo de pagamento</h3>
                        <div class="payment-methods">
                            @foreach (var metodo in metodosPagamento)
                            {
                                <button class="@ObterClasseMetodoPagamento(metodo)"
                                        type="button"
                                        disabled="@pagamentoEmCurso"
                                        @onclick="() => SelecionarMetodoPagamento(metodo)">
                                    <strong>@metodo.Nome</strong>
                                    <span>@metodo.Descricao</span>
                                </button>
                            }
                        </div>

                        @if (metodoSelecionado is not null)
                        {
                            <div class="payment-selection">
                                <strong>@metodoSelecionado.Nome</strong>
                                <span>@metodoSelecionado.Descricao</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(mensagemPagamento))
                        {
                            <div class="payment-status">@mensagemPagamento</div>
                        }

                        <div class="payment-actions">
                            @if (pagamentoConcluido)
                            {
                                <button class="btn btn-success"
                                        type="button"
                                        @onclick="ContinuarDepoisPagamento">
                                    Continuar
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        disabled="@pagamentoEmCurso"
                                        @onclick="CancelarPagamento">
                                    Cancelar
                                </button>
                                <button class="btn btn-success"
                                        type="button"
                                        disabled="@(metodoSelecionado is null || pagamentoEmCurso)"
                                        @onclick="ConfirmarPagamento">
                                    Confirmar pagamento
                                </button>
                            }
                        </div>
                    </section>
                }

                @if (!mostrarPagamento)
                {
                    <div class="cart-footer">
                        <strong>Total: @ObterTotalCarrinho().ToString("C")</strong>
                        <button class="btn btn-outline-secondary" type="button" @onclick="FecharCarrinho">
                            Voltar atras
                        </button>
                        <button class="btn btn-primary"
                                type="button"
                                disabled="@(itens.Count == 0)"
                                @onclick="MostrarPagamento">
                            Finalizar pagamento
                        </button>
                    </div>
                }
            </aside>
        }
    </Authorized>
</AuthorizeView>

@code {
    private readonly IReadOnlyList<IPagamentoStrategy> metodosPagamento = PagamentoStrategyFactory.CriarMetodos();
    private List<CarrinhoItem> itens = new();
    private bool aberto;
    private bool aCarregar;
    private bool mostrarPagamento;
    private bool pagamentoEmCurso;
    private bool pagamentoConcluido;
    private IPagamentoStrategy? metodoSelecionado;
    private string? mensagemPagamento;
    private string? mensagem;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        await CarregarCarrinho();
    }

    private async Task AbrirCarrinho()
    {
        aberto = true;
        mensagem = null;
        erro = null;
        ReiniciarPagamento();
        await CarregarCarrinho();
    }

    private void FecharCarrinho()
    {
        aberto = false;
        ReiniciarPagamento();
    }

    private async Task CarregarCarrinho()
    {
        var utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            itens = new List<CarrinhoItem>();
            return;
        }

        aCarregar = true;
        itens = (await CarrinhoService.ListarItensAsync(utilizadorId.Value)).ToList();
        aCarregar = false;
    }

    private async Task RemoverItem(int itemId)
    {
        var utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            erro = "Tem de iniciar sessao para alterar o carrinho.";
            return;
        }

        var resultado = await CarrinhoService.RemoverItemAsync(utilizadorId.Value, itemId);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            mensagem = null;
            return;
        }

        mensagem = resultado.Value;
        erro = null;
        ReiniciarPagamento();
        await CarregarCarrinho();
    }

    private void MostrarPagamento()
    {
        mostrarPagamento = true;
        mensagem = null;
        erro = null;
    }

    private void SelecionarMetodoPagamento(IPagamentoStrategy metodo)
    {
        metodoSelecionado = metodo;
        mensagemPagamento = metodo.Descricao;
    }

    private void CancelarPagamento()
    {
        ReiniciarPagamento();
    }

    private void ContinuarDepoisPagamento()
    {
        FecharCarrinho();
    }

    private async Task ConfirmarPagamento()
    {
        if (metodoSelecionado is null)
        {
            erro = "Escolha um metodo de pagamento.";
            return;
        }

        pagamentoEmCurso = true;
        erro = null;
        mensagem = null;

        var pagamentoContext = new PagamentoContext();
        pagamentoContext.SetStrategy(metodoSelecionado);
        mensagemPagamento = pagamentoContext.ExecutarPagamento(ObterTotalCarrinho());
        StateHasChanged();
        await Task.Delay(700);

        var stateContext = new PagamentoStateContext();

        while (!stateContext.Concluido)
        {
            mensagemPagamento = stateContext.MensagemEstado;
            StateHasChanged();
            await stateContext.Request();
        }

        mensagemPagamento = stateContext.MensagemEstado;

        var utilizadorId = await ObterUtilizadorIdAutenticado();

        if (utilizadorId is null)
        {
            erro = "Tem de iniciar sessao para concluir a compra.";
            pagamentoEmCurso = false;
            return;
        }

        var resultado = await CarrinhoService.FinalizarAcessosAsync(utilizadorId.Value);

        if (!resultado.Succeeded)
        {
            erro = resultado.ErrorMessage;
            pagamentoEmCurso = false;
            return;
        }

        mensagem = resultado.Value;
        pagamentoConcluido = true;
        pagamentoEmCurso = false;
        await CarregarCarrinho();
    }

    private void ReiniciarPagamento()
    {
        mostrarPagamento = false;
        pagamentoEmCurso = false;
        pagamentoConcluido = false;
        metodoSelecionado = null;
        mensagemPagamento = null;
    }

    private decimal ObterTotalCarrinho()
    {
        return itens.Sum(item => item.Preco);
    }

    private string ObterClasseMetodoPagamento(IPagamentoStrategy metodo)
    {
        return metodoSelecionado?.Nome == metodo.Nome
            ? "payment-method selected"
            : "payment-method";
    }

    private async Task<int?> ObterUtilizadorIdAutenticado()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.GetMadFlixUserId();
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = authenticationStateTask;
        _ = InvokeAsync(async () =>
        {
            await CarregarCarrinho();
            StateHasChanged();
        });
    }

    private static string ObterNomeItem(CarrinhoItem item)
    {
        return item.Festival?.Nome ?? item.Filme?.Titulo ?? "Acesso";
    }

    private static string ObterDescricaoTipo(TipoAcesso tipo)
    {
        return tipo switch
        {
            TipoAcesso.PasseDiario => "Passe diario",
            TipoAcesso.PasseCompleto => "Passe completo",
            TipoAcesso.AluguerDigital => "Aluguer digital",
            TipoAcesso.BilheteSessao => "Bilhete de sessao",
            _ => "Acesso"
        };
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }
}
