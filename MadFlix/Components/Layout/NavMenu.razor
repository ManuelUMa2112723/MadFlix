@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MadFlix</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="festivais">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Festivais
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized Context="authState">
                <div class="nav-item px-3 nav-user">
                    <span class="nav-link">Ola, @authState.User.Identity?.Name</span>
                </div>

                <div class="nav-item px-3">
                    <form class="logout-form" method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@NavigationManager.ToLocalPath()" />
                        <button class="nav-link" type="submit">
                            <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Terminar sessao
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@GetLoginUrl()">
                        <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Iniciar sessao
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@GetRegisterUrl()">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Criar conta
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string GetLoginUrl()
    {
        return $"/login?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }

    private string GetRegisterUrl()
    {
        return $"/registar?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }
}
