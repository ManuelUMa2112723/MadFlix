@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IFilmeCatalogService FilmeCatalogService

<div class="nav-shell">
    <a class="navbar-brand" href="">MadFlix</a>

    <input id="nav-toggle" type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-content">
        <nav class="nav-links" aria-label="Menu principal">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Página inicial
            </NavLink>

            <NavLink class="nav-link" href="festivais">
                Festivais
            </NavLink>
            <AuthorizeView Roles="User,Admin">
                <Authorized>
                    <NavLink class="nav-link" href="bilhetes">
                        Bilhetes
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="nav-actions">
            <form class="header-search-form" @onsubmit="PesquisarHeaderAsync" @onsubmit:preventDefault>
                <button class="header-icon-button"
                        type="submit"
                        title="Pesquisar"
                        aria-label="Pesquisar">
                    <svg class="header-search-icon" aria-hidden="true" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m16.5 16.5 4 4" />
                    </svg>
                </button>

                <div class="header-search-expanded">
                    <div class="header-search-segments" role="radiogroup" aria-label="Tipo de pesquisa">
                        <label class="header-search-segment @(headerSearchType == "filme" ? "active" : null)">
                            <input type="radio"
                                   name="headerSearchType"
                                   value="filme"
                                   checked="@(headerSearchType == "filme")"
                                   @onchange="OnHeaderSearchTypeChanged" />
                            Filme
                        </label>
                        <label class="header-search-segment @(headerSearchType == "ator" ? "active" : null)">
                            <input type="radio"
                                   name="headerSearchType"
                                   value="ator"
                                   checked="@(headerSearchType == "ator")"
                                   @onchange="OnHeaderSearchTypeChanged" />
                            Ator
                        </label>
                    </div>

                    <input value="@headerSearchTerm"
                           @oninput="OnHeaderSearchTermChanged"
                           placeholder="@(headerSearchType == "filme" ? "Pesquisar filme..." : "Pesquisar ator...")" />
                </div>
            </form>

            <UserNotifications />
            <CartDrawer />

            <AuthorizeView>
                <Authorized Context="authState">
                    <details class="profile-menu">
                        <summary class="profile-avatar-button"
                                 title="@($"Perfil de {authState.User.Identity?.Name}")"
                                 aria-label="@($"Abrir menu de perfil de {authState.User.Identity?.Name}")">
                            <span class="profile-avatar" aria-hidden="true">
                                @GetUserInitials(authState.User.Identity?.Name)
                            </span>
                        </summary>

                        <div class="profile-dropdown">
                            <div class="profile-dropdown-header">
                                <span class="profile-avatar profile-avatar-small" aria-hidden="true">
                                    @GetUserInitials(authState.User.Identity?.Name)
                                </span>
                                <div>
                                    <strong>@authState.User.Identity?.Name</strong>
                                    <span>Conta MadFlix</span>
                                </div>
                            </div>

                            <a class="profile-dropdown-item" href="perfil">
                                Minha conta
                            </a>

                            <form class="logout-form profile-dropdown-form" method="post" action="/auth/logout">
                                <AntiforgeryToken />
                                <input type="hidden" name="returnUrl" value="@NavigationManager.ToLocalPath()" />
                                <button class="profile-dropdown-item profile-dropdown-button" type="submit">
                                    Terminar sessao
                                </button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link" href="@GetLoginUrl()">
                        <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Iniciar sessao
                    </NavLink>

                    <NavLink class="nav-link" href="@GetRegisterUrl()">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Criar conta
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private string headerSearchTerm = string.Empty;
    private string headerSearchType = "filme";

    private void OnHeaderSearchTermChanged(ChangeEventArgs e)
    {
        headerSearchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private void OnHeaderSearchTypeChanged(ChangeEventArgs e)
    {
        headerSearchType = e.Value?.ToString() ?? "filme";
    }

    private async Task PesquisarHeaderAsync()
    {
        var termo = headerSearchTerm.Trim();
        if (string.IsNullOrWhiteSpace(termo))
            return;

        if (headerSearchType == "ator")
        {
            NavigationManager.NavigateTo($"/ator?nome={Uri.EscapeDataString(termo)}");
            return;
        }

        var resultado = await FilmeCatalogService.BuscarFilmeAsync(termo);

        if (!resultado.Succeeded || resultado.Value is null)
            return;

        var returnUrl = Uri.EscapeDataString(NavigationManager.ToLocalPath());
        NavigationManager.NavigateTo($"/filmes/{resultado.Value.Id}?returnUrl={returnUrl}");
    }

    private string GetLoginUrl()
    {
        return $"/login?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }

    private string GetRegisterUrl()
    {
        return $"/registar?returnUrl={Uri.EscapeDataString(NavigationManager.ToLocalPath())}";
    }

    private static string GetUserInitials(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "U";

        var parts = userName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
            return "U";

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
